local Window = Library:CreateWindow({
    Title = "Silence UI",
    Size = UDim2.fromOffset(760, 480)
})

-- Create the Tabs
local MainTab = Window:AddTab("Main")
local VisualsTab = Window:AddTab("Visuals")
local SettingsTab = Window:AddTab("Settings")

-- Create the Groupboxes (Splits into left and right columns)
local MainLeft = Window:AddLeftGroupbox(MainTab, "Player Mods")
local MainRight = Window:AddRightGroupbox(MainTab, "Teleports")
local VisualsLeft = Window:AddLeftGroupbox(VisualsTab, "ESP")
local SettingsLeft = Window:AddLeftGroupbox(SettingsTab, "Config")

-- ==========================================
-- MAIN TAB ELEMENTS
-- ==========================================

Window:AddSlider(MainLeft, "WalkSpeed", {
    Text = "Walk Speed",
    Min = 16,
    Max = 200,
    Default = 16,
    Round = true,
    Callback = function(value)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = value
        end
    end
})

Window:AddSlider(MainLeft, "JumpPower", {
    Text = "Jump Power",
    Min = 50,
    Max = 300,
    Default = 50,
    Round = true,
    Callback = function(value)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.JumpPower = value
        end
    end
})

Window:AddToggle(MainLeft, "InfiniteJump", {
    Text = "Infinite Jump",
    Default = false,
    Callback = function(state)
        print("Infinite Jump:", state)
    end
})

Window:AddButton(MainRight, {
    Text = "Teleport to Spawn",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(0, 10, 0)
            Window:Notify({ Title = "Teleported", Content = "Moved to spawn location.", Duration = 3 })
        end
    end
})

-- ==========================================
-- VISUALS TAB ELEMENTS
-- ==========================================

Window:AddToggle(VisualsLeft, "BoxESP", {
    Text = "Box ESP",
    Default = true,
    Callback = function(state)
        print("Box ESP:", state)
    end
})

Window:AddDropdown(VisualsLeft, "ESPColor", {
    Text = "ESP Color",
    Values = { "White", "Red", "Green", "Blue" },
    Default = "White",
    Callback = function(selected)
        print("ESP Color set to:", selected)
    end
})

-- ==========================================
-- SETTINGS TAB ELEMENTS
-- ==========================================

Window:AddButton(SettingsLeft, {
    Text = "Print Current Speed",
    Callback = function()
        -- Reading the slider value we set earlier via the Library.Options table
        local currentSpeed = Library.Options.WalkSpeed.Value
        Window:Notify({ 
            Title = "Current Speed", 
            Content = "Your WalkSpeed is " .. tostring(currentSpeed),
            Duration = 4
        })
    end
})

Window:AddButton(SettingsLeft, {
    Text = "Toggle Infinite Jump (Code)",
    Callback = function()
        -- Toggling the toggle via the Library.Toggles table
        local currentState = Library.Toggles.InfiniteJump.Value
        Library.Toggles.InfiniteJump:SetValue(not currentState)
    end
})
