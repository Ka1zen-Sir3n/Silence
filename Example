local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Ka1zen-Sir3n/Silence/main/Library"))()

local Window = Library:CreateWindow({
    Title = "Silence",
    Size = UDim2.fromOffset(760, 480)
})

-- // Create Tabs
local MainTab = Window:AddTab("Main")
local VisualsTab = Window:AddTab("Visuals")
local SettingsTab = Window:AddTab("Settings")

-- // Create Groupboxes
local CombatBox = Window:AddLeftGroupbox(MainTab, "Combat")
local PlayerBox = Window:AddRightGroupbox(MainTab, "Player")
local ESPBox = Window:AddLeftGroupbox(VisualsTab, "ESP")
local MiscBox = Window:AddRightGroupbox(VisualsTab, "Misc")
local ConfigBox = Window:AddLeftGroupbox(SettingsTab, "Configuration")

-- // ==========================================
-- // MAIN TAB -> COMBAT BOX
-- // ==========================================

Window:AddToggle(CombatBox, "SilentAim", {
    Text = "Silent Aim",
    Default = false,
    Callback = function(state)
        print("Silent Aim toggled:", state)
    end
})

Window:AddDropdown(CombatBox, "AimPart", {
    Text = "Aim Part",
    Values = { "Head", "Torso", "Nearest" },
    Default = "Head",
    Callback = function(selected)
        print("Aim Part set to:", selected)
    end
})

Window:AddSlider(CombatBox, "FOV", {
    Text = "Aim FOV",
    Min = 10,
    Max = 360,
    Default = 90,
    Round = true,
    Suffix = "°",
    Callback = function(value)
        print("FOV set to:", value)
    end
})

-- // ==========================================
-- // MAIN TAB -> PLAYER BOX
-- // ==========================================

Window:AddSlider(PlayerBox, "WalkSpeed", {
    Text = "Walk Speed",
    Min = 16,
    Max = 200,
    Default = 16,
    Round = true,
    Callback = function(value)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = value
        end
    end
})

Window:AddButton(PlayerBox, {
    Text = "Reset Character",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if char then char:BreakJoints() end
        Window:Notify({ Title = "Reset", Content = "Character has been reset.", Duration = 3 })
    end
})

-- // ==========================================
-- // VISUALS TAB -> ESP BOX
-- // ==========================================

Window:AddToggle(ESPBox, "BoxESP", {
    Text = "Box ESP",
    Default = true,
    Callback = function(state)
        print("Box ESP:", state)
    end
})

Window:AddToggle(ESPBox, "NameESP", {
    Text = "Name ESP",
    Default = false,
    Callback = function(state)
        print("Name ESP:", state)
    end
})

Window:AddDropdown(ESPBox, "ESPColor", {
    Text = "ESP Color",
    Values = { "White", "Red", "Green", "Blue" },
    Default = "White",
    Callback = function(selected)
        print("ESP Color set to:", selected)
    end
})

-- // ==========================================
-- // VISUALS TAB -> MISC BOX
-- // ==========================================

Window:AddToggle(MiscBox, "Fullbright", {
    Text = "Fullbright",
    Default = false,
    Callback = function(state)
        local lighting = game:GetService("Lighting")
        if state then
            lighting.Ambient = Color3.fromRGB(255, 255, 255)
            lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        else
            lighting.Ambient = Color3.fromRGB(0, 0, 0)
            lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
        end
    end
})

Window:AddSlider(MiscBox, "CameraFOV", {
    Text = "Camera FOV",
    Min = 70,
    Max = 120,
    Default = 70,
    Round = true,
    Callback = function(value)
        workspace.CurrentCamera.FieldOfView = value
    end
})

-- // ==========================================
-- // SETTINGS TAB -> CONFIGURATION BOX
-- // ==========================================

Window:AddButton(ConfigBox, {
    Text = "Print WalkSpeed Value",
    Callback = function()
        local speed = Library.Options.WalkSpeed.Value
        Window:Notify({ Title = "Current Speed", Content = "WalkSpeed is " .. tostring(speed), Duration = 4 })
    end
})

Window:AddButton(ConfigBox, {
    Text = "Force Enable Box ESP",
    Callback = function()
        Library.Toggles.BoxESP:SetValue(true)
        Window:Notify({ Title = "Forced", Content = "Box ESP turned on.", Duration = 3 })
    end
})

Window:AddButton(ConfigBox, {
    Text = "Test Notification",
    Callback = function()
        Window:Notify({ Title = "Notification", Content = "This is a test notification.", Duration = 3 })
    end
})
