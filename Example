local Library = loadstring(game:HttpGet("YOUR_RAW_GITHUB_LINK"))()

local Window = Library:CreateWindow({
    Title = "Silence",
    Size = UDim2.fromOffset(760, 480)
})

-- Create Tabs
local MainTab = Window:AddTab("Main")
local VisualsTab = Window:AddTab("Visuals")
local SettingsTab = Window:AddTab("Settings")

-- Create Groupboxes (Left & Right)
local MainLeft = Window:AddLeftGroupbox(MainTab, "Combat")
local MainRight = Window:AddRightGroupbox(MainTab, "Player")
local VisualsLeft = Window:AddLeftGroupbox(VisualsTab, "ESP Options")
local SettingsLeft = Window:AddLeftGroupbox(SettingsTab, "Menu")

-- Add Buttons
Window:AddButton(MainLeft, {
    Text = "Reset Character",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if char then char:BreakJoints() end
        Window:Notify({ Title = "Reset", Content = "Character has been reset.", Duration = 3 })
    end
})

-- Add Toggles (Using ID for easy access)
local autoFarm = Window:AddToggle(MainLeft, "AutoFarm", {
    Text = "Auto Farm",
    Default = false,
    Callback = function(state)
        print("AutoFarm is now:", state)
    end
})

-- You can change it later via the Toggles table:
-- Library.Toggles.AutoFarm:SetValue(true)

-- Add Sliders
Window:AddSlider(MainLeft, "WalkSpeed", {
    Text = "Walk Speed",
    Min = 16,
    Max = 200,
    Default = 16,
    Round = true,
    Callback = function(value)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = value
        end
    end
})

-- Add Dropdowns
Window:AddDropdown(VisualsLeft, "ESPMode", {
    Text = "ESP Mode",
    Values = { "Box", "Name", "Tracer" },
    Default = "Box",
    Callback = function(selected)
        print("ESP Mode set to:", selected)
    end
})

-- Add Toggles to Visuals
Window:AddToggle(VisualsLeft, "ShowFPS", {
    Text = "Show FPS Counter",
    Default = true,
    Callback = function(state)
        -- Logic to show/hide FPS
    end
})

-- Add a Notification Button
Window:AddButton(SettingsLeft, {
    Text = "Send Test Notification",
    Callback = function()
        Window:Notify({ Title = "Test", Content = "SilenceUI is working perfectly!" })
    end,
})

-- Accessing values via the Options table
Window:AddButton(SettingsLeft, {
    Text = "Print Current WalkSpeed",
    Callback = function()
        print("Current Speed:", Library.Options.WalkSpeed.Value)
    end
})
