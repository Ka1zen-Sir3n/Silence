            Type = state and "Success" or "Info",
            Time = 2.5,
        })
    end,
})

TrigTab:Slider({
    Name = "Trigger Delay",
    Description = "delay before firing",
    Min = 0,
    Max = 500,
    Default = 50,
    Step = 5,
    Suffix = "ms",
    Flag = "Triggerbot_Delay",
})

TrigTab:Slider({
    Name = "Trigger FOV",
    Description = "field of view for trigger detection",
    Min = 1,
    Max = 100,
    Default = 15,
    Step = 1,
    Suffix = "°",
    Flag = "Triggerbot_FOV",
})
