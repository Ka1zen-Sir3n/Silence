function Silence:Button(tab, opts)
    opts = opts or {}
    local T = self.Theme
    local btn = New("TextButton", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = T.Surface,
        BackgroundTransparency = 0,
        Text = opts.Text or "Button",
        TextColor3 = T.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    })
    Corner(btn, 10)
    local s = Stroke(btn, T.HairlineSoft, 1, 0.2)

    btn.MouseEnter:Connect(function()
        Tween(btn, 0.18, { BackgroundColor3 = T.SurfaceAlt }).Play()
        Tween(s, 0.18, { Transparency = 0 }).Play()
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, 0.18, { BackgroundColor3 = T.Surface }).Play()
        Tween(s, 0.18, { Transparency = 0.2 }).Play()
    end)
    btn.MouseButton1Down:Connect(function()
