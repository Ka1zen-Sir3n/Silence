		table.insert(UserText, New("TextLabel", { Position = UDim2.fromOffset(54, 28), Size = UDim2.new(1, -62, 0, 16), Text = "@" .. LocalPlayer.Name, TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd, Scheme = { TextColor3 = "DimFontColor" }, Parent = UserPanel }))
		task.spawn(function()
