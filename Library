    self.Tabs = {}
    self.ActiveTab = nil
    self.Dragging = false
    self.Theme = opts.Theme and Themes[opts.Theme] or Silence.Theme
    self.Size = opts.Size or UDim2.fromOffset(620, 460)
    self.Position = opts.Position or UDim2.new(0.5, -310, 0.5, -230)
    self.Title = opts.Title or "Silence"
    self.Subtitle = opts.Subtitle or "v2.0"
    self.Notifications = {}
    self:Build()
    return self
end

