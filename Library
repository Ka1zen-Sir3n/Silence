        Parent = profile, Size = UDim2.new(1, -40, 0, 16), Position = UDim2.new(0, 42, 0.5, 0),
        BackgroundTransparency = 1, Text = "@" .. LocalPlayer.Name, TextColor3 = T.TextMuted,
        Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left
