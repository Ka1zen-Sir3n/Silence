	local SearchFrame = New("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -54, 0.5, 0), Size = UDim2.fromOffset(190, 30), BackgroundTransparency = 0.3, Scheme = { BackgroundColor3 = "DarkColor" }, Parent = Header })
