		local Bar = New("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -8, 0.5, 0), Size = UDim2.fromOffset(3, 18), BackgroundTransparency = 1, Scheme = { BackgroundColor3 = "AccentColor" }, Parent = Btn })
		Corner(Bar, "full")
		local iconObj
		local I = New("ImageLabel", { Position = UDim2.new(0, 11, 0.5, -9), Size = UDim2.fromOffset(18, 18), Scheme = { ImageColor3 = function() return Tab.Active and Library.Scheme.AccentColor or Library.Scheme.DimFontColor end }, Parent = Btn })
		if ApplyIcon(I, icon) then iconObj = I else
			I:Destroy()
			iconObj = New("Frame", { Position = UDim2.new(0, 16, 0.5, -4), Size = UDim2.fromOffset(8, 8), Scheme = { BackgroundColor3 = function() return Tab.Active and Library.Scheme.AccentColor or Library.Scheme.DimFontColor end }, Parent = Btn })
			Corner(iconObj, "full")
		end
		local Text = New("TextLabel", { Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -46, 1, 0), Text = name, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Scheme = { TextColor3 = function() return Tab.Active and Library.Scheme.FontColor or Library.Scheme.DimFontColor end }, Parent = Btn })
		Tab.Button, Tab.Text = Btn, Text
		if self.SidebarCollapsed then Text.Visible = false end

		local Page = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = Content })
		Tab.Page = Page
		local function column(left)
			local s = New("ScrollingFrame", {
				Position = left and UDim2.new(0, 14, 0, 14) or UDim2.new(0.5, 7, 0, 14),
				Size = UDim2.new(0.5, -21, 1, -14), ScrollBarThickness = 3, Parent = Page,
			})
			Pad(s, 0, 0, 4, 14); List(s, 12)
			s:GetPropertyChangedSignal("CanvasPosition"):Connect(function() end)
			return s
		end
		Tab.Left, Tab.Right = column(true), column(false)

		function Tab:Show()
			local prev = Window.ActiveTab
			if prev and prev ~= self then
				prev.Active = false; prev.Page.Visible = false
				Library:Tween(prev.Button, { BackgroundTransparency = 1 })
				Library:Tween(prev.Bar, { BackgroundTransparency = 1 })
			end
			Library:ClosePopups()
			Window.ActiveTab = self
			self.Active = true
			self.Page.Visible = true
			Library:Tween(Btn, { BackgroundTransparency = 0.88 })
			Library:Tween(Bar, { BackgroundTransparency = 0 })
			ActiveTitle.Text = string.lower(self.Name)
			Library:UpdateColors()
			if Library.Searching then Library:Search(Library.SearchText) end
		end
		function Tab:Hide() Btn.Visible = false; self.Page.Visible = false end
		function Tab:SetVisible(v) Btn.Visible = v end
		function Tab:AddGroupbox(i)
			i = Validate(i, { Name = "Groupbox", Side = 1, IconName = nil })
			return CreateGroupbox(self, i.Side, i.Name, i.IconName)
		end
		function Tab:AddTabbox(i)
			i = Validate(i, { Side = 1 })
			return CreateTabbox(self, i.Side)
		end
		function Tab:AddLeftGroupbox(n, ic) return CreateGroupbox(self, 1, n, ic) end
		function Tab:AddRightGroupbox(n, ic) return CreateGroupbox(self, 2, n, ic) end
		function Tab:AddLeftTabbox() return CreateTabbox(self, 1) end
		function Tab:AddRightTabbox() return CreateTabbox(self, 2) end
		Tab.Bar = Bar

		Btn.MouseButton1Click:Connect(function() Tab:Show() end)
		Btn.MouseEnter:Connect(function() if not Tab.Active then Library:Tween(Btn, { BackgroundTransparency = 0.94 }) end end)
		Btn.MouseLeave:Connect(function() if not Tab.Active then Library:Tween(Btn, { BackgroundTransparency = 1 }) end end)
		if desc then Library:AddTooltip(desc, Btn) end

		table.insert(self.Tabs, Tab)
		Library.Tabs[name] = Tab
		if #self.Tabs == 1 then Tab:Show() end
		return Tab
	end

	Library.Window = Window
	Window.Library = Library

	-- mobile toggle button
	if Library.IsMobile then
		local MB = New("TextButton", { Size = UDim2.fromOffset(44, 44), Position = UDim2.new(0, 16, 0.5, 0), ZIndex = 30, Text = "S", TextSize = 18, Scheme = { BackgroundColor3 = "AccentColor", Font = "BoldFont" }, BackgroundTransparency = 0, Parent = Overlay })
		MB.TextColor3 = Color3.new(1, 1, 1)
		Corner(MB, "full")
		MB.MouseButton1Click:Connect(function() Library:Toggle() end)
		Library:MakeDraggable(MB, MB)
	end

	if options.AutoShow then Library:Toggle(true) end
	return Window
end

return Library
