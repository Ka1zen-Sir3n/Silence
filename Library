    local profile = Create("Frame", { Parent = window.Sidebar, Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, LayoutOrder = 9999 })
    Create("ImageLabel", {
        Parent = profile, Size = UDim2.fromOffset(32, 32), Position = UDim2.new(0, 0, 0.5, -16),
        BackgroundColor3 = T.Glass, Image = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150"
