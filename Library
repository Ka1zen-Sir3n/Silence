local CurrentTip, TipToken = nil, 0

function Library:AddTooltip(text, target)
	local tip = { Text = text, Disabled = false }
	target.MouseEnter:Connect(function()
		if tip.Disabled or not tip.Text or tip.Text == "" then return end
		TipToken += 1
		local token = TipToken
		CurrentTip = tip
		task.delay(0.25, function()
			if token == TipToken and CurrentTip == tip and not Library.Unloaded then
				TipLabel.Text = tostring(tip.Text)
				TipFrame.Visible = true
			end
		end)
	end)
	target.MouseLeave:Connect(function()
		if CurrentTip == tip then CurrentTip = nil; TipToken += 1; TipFrame.Visible = false end
	end)
	function tip:SetText(t) self.Text = t; if CurrentTip == self then TipLabel.Text = tostring(t) end end
	return tip
end

Library:GiveSignal(RunService.RenderStepped:Connect(function()
	if TipFrame.Visible then
		local m = UserInputService:GetMouseLocation() / Library.DPIScale
		TipFrame.Position = UDim2.fromOffset(m.X + 14, m.Y + 14)
	end
end))

