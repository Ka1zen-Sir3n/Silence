local function MakeButton(self, row, info, parentBtn)
	info = Validate(info, { Text = "Button", Func = function() end, DoubleClick = false, Disabled = false, Visible = true, Risky = false })
	local Btn = { Type = "Button", Text = info.Text, Func = info.Func, DoubleClick = info.DoubleClick, Risky = info.Risky, _list = parentBtn and parentBtn._list or {} }
	table.insert(Btn._list, Btn)
	local B = New("TextButton", {
		Size = UDim2.fromScale(1, 1), Text = info.Text, TextSize = 13, LayoutOrder = #Btn._list,
		BackgroundTransparency = 0.2, Scheme = { BackgroundColor3 = "MainColor", TextColor3 = function() return Btn.Risky and Library.Scheme.RedColor or Library.Scheme.FontColor end }, Parent = row,
	})
	Corner(B, 8); Stroke(B, "OutlineColor", 0.45)
	Btn.Button = B
	local n = #Btn._list
	for _, b in ipairs(Btn._list) do b.Button.Size = UDim2.new(1 / n, -(6 * (n - 1)) / n, 1, 0) end

	local token = 0
	local armed = false
	B.MouseEnter:Connect(function() if not Btn.Disabled then Library:Tween(B, { BackgroundColor3 = Library.Scheme.HoverColor }) end end)
	B.MouseLeave:Connect(function() Library:Tween(B, { BackgroundColor3 = Library.Scheme.MainColor }) end)
	B.MouseButton1Click:Connect(function()
		if Btn.Disabled then return end
		if Btn.DoubleClick and not armed then
			armed = true; token += 1
			local t = token
			B.Text = "Click again to confirm"
			task.delay(2, function() if t == token and armed then armed = false; B.Text = Btn.Text end end)
			return
		end
		if armed then armed = false; token += 1; B.Text = Btn.Text end
		Library:SafeCallback(Btn.Func)
	end)

	function Btn:SetText(t) self.Text = t; B.Text = t end
	function Btn:SetVisible(v) self.Visible = v; B.Visible = v end
	function Btn:SetDisabled(d) self.Disabled = d and true or false; B.TextTransparency = self.Disabled and 0.6 or 0 end
	function Btn:AddButton(i)
		if type(i) ~= "table" then i = { Text = i } end
		return MakeButton(self, row, i, self)
	end
	Btn.Visible = info.Visible ~= false
	B.Visible = Btn.Visible
	Btn:SetDisabled(info.Disabled)
	if info.Tooltip then Btn.TooltipObj = Library:AddTooltip(info.Tooltip, B) end
	return Btn
end

function Funcs:AddButton(a, b)
	local info = type(a) == "table" and a or { Text = a, Func = b }
	local Holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = NextOrder(self), Parent = self.Container })
	List(Holder, 6, Enum.FillDirection.Horizontal)
	local Btn = MakeButton(self, Holder, info, nil)
	Btn.Holder = Holder
	Btn._searchHidden = false
	table.insert(Library.SearchItems, { Obj = Btn, Text = string.lower(tostring(info.Text or "")), Groupbox = self.Groupbox, Tab = self.Tab })
	function Btn:SetVisible(v) self.Visible = v; self.Button.Visible = v; Holder.Visible = v and not self._searchHidden end
	if info.Idx then Library.Buttons[info.Idx] = Btn end
	return Btn
end

