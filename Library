	local ring = New("Frame", { Size = UDim2.fromOffset(9, 9), BackgroundTransparency = 1, Parent = mag })
	Corner(ring, "full"); Stroke(ring, "DimFontColor", 0, 1.5)
	local handle = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(11.5, 11.5), Size = UDim2.fromOffset(2, 5), Rotation = -45, Scheme = { BackgroundColor3 = "DimFontColor" }, Parent = mag })
