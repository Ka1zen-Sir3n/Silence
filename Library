	local Content = New("Frame", { Position = UDim2.fromOffset(SW, 56), Size = UDim2.new(1, -SW, 1, -56), BackgroundTransparency = 1, Parent = Main })
	Window.Content = Content

	Library:MakeDraggable(Main, Header)
	Library:MakeDraggable(Main, SideHeader)

	-- resize grip
	if options.Resizable then
		local Grip = New("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(20, 20), ZIndex = 5, Parent = Main })
		for i = 0, 1 do
			local l = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(12 + i * 3, 12 + i * 3 - 3 * 0), Size = UDim2.fromOffset(1, 8 - i * 4), Rotation = 45, BackgroundTransparency = 0.4, Scheme = { BackgroundColor3 = "DimFontColor" }, Parent = Grip })
		end
		Grip.InputBegan:Connect(function(input)
			if not IsPointer(input) then return end
			local start = Vector2.new(input.Position.X, input.Position.Y)
			local origin = Vector2.new(Main.AbsoluteSize.X, Main.AbsoluteSize.Y) / Library.DPIScale
			local centered = Main.AnchorPoint.X == 0.5
			local startPos = Main.Position
			Library:ClosePopups()
			local mc, ec
			mc = UserInputService.InputChanged:Connect(function(i)
				if IsMove(i) then
					local d = (Vector2.new(i.Position.X, i.Position.Y) - start) / Library.DPIScale
					local w = math.max(560, origin.X + d.X)
					local h = math.max(380, origin.Y + d.Y)
					Main.Size = UDim2.fromOffset(w, h)
					if centered then
						Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + (w - origin.X) / 2, startPos.Y.Scale, startPos.Y.Offset + (h - origin.Y) / 2)
					end
				end
			end)
			ec = UserInputService.InputEnded:Connect(function(i)
				if IsPointer(i) then mc:Disconnect(); ec:Disconnect() end
			end)
		end)
	end

