	local idx, info
	if type(a) == "table" then info = a
	elseif type(b) == "table" then idx, info = a, b
	else info = { Text = a, DoesWrap = b } end
	info = Validate(info, { Text = "Label", DoesWrap = false, Visible = true })
	local LabelObj = { Type = "Label", Text = info.Text, _addons = 0 }
	local Holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = NextOrder(self), Parent = self.Container })
	local Label = New("TextLabel", { Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.Y, Text = info.Text, TextWrapped = info.DoesWrap, TextYAlignment = Enum.TextYAlignment.Top, Scheme = { TextColor3 = "FontColor" }, Parent = Holder })
	Label.TextYAlignment = info.DoesWrap and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
	if not info.DoesWrap then Label.TextTruncate = Enum.TextTruncate.AtEnd end
	local Right = MakeRight(Holder, true)
	FitLabel(Label, Right)
	LabelObj.Right = Right
	function LabelObj:SetText(t)
		self.Text = t; Label.Text = t
		for _, s in ipairs(Library.SearchItems) do if s.Obj == self then s.Text = string.lower(tostring(t)) end end
	end
	function LabelObj:AddKeyPicker(i, inf) AttachKeyPicker(self, i, inf); return self end
	function LabelObj:AddColorPicker(i, inf) AttachColorPicker(self, i, inf); return self end
	InitElement(self, LabelObj, Holder, info.Text, info)
	if idx then Library.Labels[idx] = LabelObj end
	return LabelObj
end

