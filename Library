-- Input
----------------------------------------------------------------------
function Funcs:AddInput(idx, info)
	info = Validate(info, { Text = nil, Default = "", Placeholder = "", Numeric = false, Finished = false, ClearTextOnFocus = false, MaxLength = nil, Callback = function() end, Disabled = false, Visible = true })
	local Input = { Type = "Input", Value = tostring(info.Default), Text = info.Text, Numeric = info.Numeric, Finished = info.Finished }
	local hasLabel = info.Text ~= nil and info.Text ~= ""
	local Holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, hasLabel and 48 or 28), LayoutOrder = NextOrder(self), Parent = self.Container })
	local Label
	if hasLabel then Label = New("TextLabel", { Size = UDim2.new(1, 0, 0, 18), Text = info.Text, Parent = Holder }) end
	local Box = New("Frame", { Position = UDim2.new(0, 0, 0, hasLabel and 20 or 0), Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 0.2, Scheme = { BackgroundColor3 = "DarkColor" }, Parent = Holder })
	Corner(Box, 8)
	local st = Stroke(Box, "OutlineColor", 0.45)
	local TB = New("TextBox", { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = Input.Value, PlaceholderText = info.Placeholder, ClearTextOnFocus = info.ClearTextOnFocus, TextSize = 13, ClipsDescendants = true, Scheme = { PlaceholderColor3 = "DimFontColor" }, Parent = Box })

	local function apply(text, fire)
		if info.MaxLength and #text > info.MaxLength then text = string.sub(text, 1, info.MaxLength) end
		if Input.Numeric and text ~= "" and tonumber(text) == nil then
			TB.Text = Input.Value
			return
		end
		if Input.Value == text then return end
		Input.Value = text
		if TB.Text ~= text then TB.Text = text end
		if fire then Input:_Fire(text) end
	end
	function Input:SetValue(t) apply(tostring(t), true) end
	function Input:SetText(t) self.Text = t; if Label then Label.Text = t end end
	function Input:SetDisabled(d) self.Disabled = d and true or false; TB.TextEditable = not self.Disabled end

	TB.Focused:Connect(function() Library:Tween(st, { Color = Library.Scheme.AccentColor }) end)
	TB.FocusLost:Connect(function(enter)
		Library:Tween(st, { Color = Library.Scheme.OutlineColor })
		apply(TB.Text, true)
		TB.Text = Input.Value
	end)
	if not info.Finished then
		TB:GetPropertyChangedSignal("Text"):Connect(function()
			if TB:IsFocused() then
				local t = TB.Text
				if Input.Numeric and t ~= "" and tonumber(t) == nil and t ~= "-" and t ~= "." then return end
				if Input.Numeric and (t == "-" or t == ".") then return end
				if info.MaxLength and #t > info.MaxLength then TB.Text = string.sub(t, 1, info.MaxLength); return end
				if Input.Value ~= t then Input.Value = t; Input:_Fire(t) end
			end
		end)
	end
	InitElement(self, Input, Holder, info.Text or info.Placeholder, info)
	Input:SetDisabled(info.Disabled)
	Register(idx, Input)
	return Input
end

----------------------------------------------------------------------
-- Dropdown
----------------------------------------------------------------------
function Funcs:AddDropdown(idx, info)
	info = Validate(info, { Values = {}, Default = nil, Multi = false, AllowNull = false, Text = nil, MaxVisibleDropdownItems = 8, SpecialType = nil, ExcludeLocalPlayer = false, Callback = function() end, Disabled = false, Visible = true })
	local DD = { Type = "Dropdown", Multi = info.Multi, Values = {}, Text = info.Text, SpecialType = info.SpecialType }

	local function specialValues()
		local vals = {}
		if info.SpecialType == "Player" then
			for _, p in ipairs(Players:GetPlayers()) do
				if not (info.ExcludeLocalPlayer and p == LocalPlayer) then table.insert(vals, p.Name) end
			end
		elseif info.SpecialType == "Team" then
			for _, t in ipairs(GetService("Teams"):GetTeams()) do table.insert(vals, t.Name) end
		end
		return vals
	end
	DD.Values = info.SpecialType and specialValues() or info.Values
	DD.Value = info.Multi and {} or nil

	local d = info.Default
	if info.Multi then
		if type(d) == "table" then
			for k, v in pairs(d) do
				if type(k) == "number" then
					local name = type(v) == "number" and DD.Values[v] or v
					if name then DD.Value[name] = true end
				elseif v then DD.Value[k] = true end
			end
		end
	else
		if type(d) == "number" then DD.Value = DD.Values[d] elseif type(d) == "string" then DD.Value = d end
	end

	local hasLabel = info.Text ~= nil and info.Text ~= ""
	local Holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, hasLabel and 52 or 30), LayoutOrder = NextOrder(self), Parent = self.Container })
	local Label
	if hasLabel then Label = New("TextLabel", { Size = UDim2.new(1, 0, 0, 18), Text = info.Text, Parent = Holder }) end
	local Field = New("TextButton", { Position = UDim2.new(0, 0, 0, hasLabel and 22 or 0), Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 0.2, Scheme = { BackgroundColor3 = "DarkColor" }, Parent = Holder })
	Corner(Field, "full")
	local fst = Stroke(Field, "OutlineColor", 0.45)
	local Display = New("TextLabel", { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -40, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 13, Parent = Field })
	local Arrow = Chevron(Field)
	Arrow.Position = UDim2.new(1, -18, 0.5, 0)

	function DD:GetActiveValues()
		if self.Multi then
			local out = {}
			for _, v in ipairs(self.Values) do if self.Value[v] then table.insert(out, v) end end
			return out
		end
		return self.Value and { self.Value } or {}
	end
	function DD:Display()
		local act = self:GetActiveValues()
		Display.Text = #act == 0 and "--" or table.concat(act, ", ")
		Display.TextTransparency = (#act == 0 or self.Disabled) and 0.5 or 0
	end

	local Menu, MenuConn, Popup, Items = nil, nil, nil, {}
	local function refreshItems()
		for name, b in pairs(Items) do
			local sel = DD.Multi and DD.Value[name] or (DD.Value == name)
			b.Label.TextColor3 = sel and Library.Scheme.AccentColor or Library.Scheme.FontColor
			b.Mark.Visible = sel and true or false
		end
	end
	local function closeMenu()
		if not Menu then return end
		if MenuConn then MenuConn:Disconnect(); MenuConn = nil end
		Menu:Destroy(); Menu = nil; Items = {}
		Library:UnregisterPopup(Popup); Popup = nil
		Library:Tween(Arrow, { Rotation = 0 })
		Library:Tween(fst, { Color = Library.Scheme.OutlineColor })
	end
	local function commit()
		DD:Display()
		Library:UpdateDependencyBoxes()
		DD:_Fire(DD.Value)
	end
	local function openMenu()
		if DD.Disabled or Menu then return end
		Library:ClosePopups()
		local scale = Library.DPIScale
		local itemH = 26
		local n = #DD.Values
		local visible = math.max(1, math.min(n, info.MaxVisibleDropdownItems))
		local height = visible * itemH + 8
		Menu = New("Frame", { Size = UDim2.fromOffset(Field.AbsoluteSize.X / scale, height), ZIndex = 20, BackgroundTransparency = 0.04, Scheme = { BackgroundColor3 = "BackgroundColor" }, Parent = Overlay })
		Corner(Menu, 12); Stroke(Menu, "OutlineColor", 0.3)
		local Scroll = New("ScrollingFrame", { Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8), ScrollBarThickness = 2, Parent = Menu })
		List(Scroll, 0)
		for i, name in ipairs(DD.Values) do
			local B = New("TextButton", { Size = UDim2.new(1, 0, 0, itemH), LayoutOrder = i, Parent = Scroll })
			local L = New("TextLabel", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -36, 1, 0), Text = tostring(name), TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, Parent = B })
			local Mark = New("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(6, 6), Scheme = { BackgroundColor3 = "AccentColor" }, Visible = false, Parent = B })
			Corner(Mark, "full")
			Items[name] = { Button = B, Label = L, Mark = Mark }
			B.MouseEnter:Connect(function() B.BackgroundTransparency = 0.88; B.BackgroundColor3 = Library.Scheme.FontColor end)
			B.MouseLeave:Connect(function() B.BackgroundTransparency = 1 end)
			Corner(B, 8)
			B.MouseButton1Click:Connect(function()
				if DD.Multi then
					DD.Value[name] = not DD.Value[name] or nil
					refreshItems(); commit()
				else
					if DD.Value == name then
						if info.AllowNull then DD.Value = nil else closeMenu(); return end
					else DD.Value = name end
					closeMenu(); commit()
				end
			end)
		end
		refreshItems()
		Library:Tween(Arrow, { Rotation = 180 })
		Library:Tween(fst, { Color = Library.Scheme.AccentColor })
		Popup = { Frame = Menu, Anchor = Field, Close = closeMenu }
		Library:RegisterPopup(Popup)
		MenuConn = RunService.RenderStepped:Connect(function()
			if not Menu then return end
			if not Library:IsVisible(Field) then closeMenu(); return end
			local p, s = Field.AbsolutePosition, Field.AbsoluteSize
			local y = p.Y + s.Y + 4
			if y + height * scale > Overlay.AbsoluteSize.Y then y = p.Y - height * scale - 4 end
			Menu.Position = UDim2.fromOffset(p.X / scale, y / scale)
			Menu.Size = UDim2.fromOffset(s.X / scale, height)
		end)
	end
	Field.MouseButton1Click:Connect(function() if Menu then closeMenu() else openMenu() end end)

	function DD:SetValue(v)
		if self.Multi then
			self.Value = {}
			if type(v) == "table" then
				for k, val in pairs(v) do
					if type(k) == "number" then self.Value[val] = true elseif val then self.Value[k] = true end
				end
			end
		else
			self.Value = v
		end
		refreshItems(); commit()
	end
	function DD:SetValues(vals)
		self.Values = vals
		if self.Multi then
			for k in pairs(self.Value) do if not table.find(vals, k) then self.Value[k] = nil end end
		elseif self.Value and not table.find(vals, self.Value) then self.Value = nil end
		closeMenu(); self:Display(); Library:UpdateDependencyBoxes()
	end
	function DD:AddValues(vals)
		if type(vals) ~= "table" then vals = { vals } end
		for _, v in ipairs(vals) do table.insert(self.Values, v) end
		closeMenu()
	end
	function DD:SetText(t) self.Text = t; if Label then Label.Text = t end end
	function DD:SetDisabled(dis) self.Disabled = dis and true or false; closeMenu(); self:Display() end

	InitElement(self, DD, Holder, info.Text or "dropdown", info)
	if info.Tooltip then DD.TooltipObj = Library:AddTooltip(info.Tooltip, Field) end
	DD.Disabled = info.Disabled
	DD:Display()

	if info.SpecialType then
		local function upd() DD:SetValues(specialValues()) end
		if info.SpecialType == "Player" then
			Library:GiveSignal(Players.PlayerAdded:Connect(upd))
			Library:GiveSignal(Players.PlayerRemoving:Connect(function() task.defer(upd) end))
		end
	end
	Register(idx, DD)
	return DD
end

