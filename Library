local function New(class, props, children)
	local inst = Instance.new(class)
	local d = ClassDefaults[class]
	if d then for k, v in pairs(d) do inst[k] = v end end
	props = props or {}
	local scheme = props.Scheme
	if TextClasses[class] then
		local base = {}
		if props.TextColor3 == nil then base.TextColor3 = "FontColor" end
		if props.Font == nil then base.Font = "Font" end
		if scheme then for k, v in pairs(scheme) do base[k] = v end end
		scheme = base
	end
	for k, v in pairs(props) do
		if k ~= "Scheme" and k ~= "Parent" then inst[k] = v end
	end
	if children then for _, c in ipairs(children) do c.Parent = inst end end
	if scheme and next(scheme) then Library:Register(inst, scheme) end
	if props.Parent then inst.Parent = props.Parent end
	return inst
end
Library.New = New

local function Corner(parent, r)
	return New("UICorner", { CornerRadius = r == "full" and UDim.new(1, 0) or UDim.new(0, r), Parent = parent })
end

local function Stroke(parent, key, transparency, thickness)
	return New("UIStroke", {
		Thickness = thickness or 1, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Scheme = { Color = key or "OutlineColor" }, Parent = parent,
	})
end

local function Pad(parent, l, t, r, b)
	t = t or l; r = r or l; b = b or t
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b), Parent = parent,
	})
end

local function List(parent, padding, dir)
	return New("UIListLayout", {
		Padding = UDim.new(0, padding or 0), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = dir or Enum.FillDirection.Vertical, Parent = parent,
	})
end

local function Chevron(parent)
	local holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Parent = parent })
	local a = New("Frame", { Size = UDim2.fromOffset(2, 6), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(3.75, 6.25), Rotation = -45, Scheme = { BackgroundColor3 = "DimFontColor" }, Parent = holder })
	local b = New("Frame", { Size = UDim2.fromOffset(2, 6), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(8.25, 6.25), Rotation = 45, Scheme = { BackgroundColor3 = "DimFontColor" }, Parent = holder })
	Corner(a, 1); Corner(b, 1)
	return holder
end

local TInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
function Library:Tween(inst, props, t)
	if self.Unloaded or not inst then return end
	local tw = TweenService:Create(inst, t and TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) or TInfo, props)
	tw:Play()
	return tw
end

function Library:GiveSignal(conn)
	table.insert(self.Signals, conn)
	return conn
end

function Library:SafeCallback(fn, ...)
	if type(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then warn("[Silence] callback error: " .. tostring(err)) end
end

function Library:OnUnload(fn)
	table.insert(self.UnloadCallbacks, fn)
end

function Library:GetTextBounds(text, size, width)
	return TextService:GetTextSize(text, size or 14, self.Scheme.Font, Vector2.new(width or 1000, 1000))
end

local function GuiInsetY()
	return GuiService:GetGuiInset().Y
end

local function InputPos(input)
	return Vector2.new(input.Position.X, input.Position.Y + GuiInsetY())
end

local function IsPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

function Library:IsMouseOver(frame)
	local m = UserInputService:GetMouseLocation()
	local p, s = frame.AbsolutePosition, frame.AbsoluteSize
	return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
end

function Library:IsVisible(inst)
	local cur = inst
	while cur and cur ~= self.ScreenGui do
		if cur:IsA("GuiObject") and not cur.Visible then return false end
		cur = cur.Parent
	end
	return cur == self.ScreenGui and self.Toggled
end

-- drag helper: calls fn(absPos) while pointer is held on `hit`
local function Dragify(hit, fn, onEnd)
	hit.InputBegan:Connect(function(input)
		if not IsPointer(input) then return end
		fn(InputPos(input))
		local mc, ec
		mc = UserInputService.InputChanged:Connect(function(i)
			if IsMove(i) then fn(InputPos(i)) end
		end)
		ec = UserInputService.InputEnded:Connect(function(i)
			if IsPointer(i) then
				mc:Disconnect(); ec:Disconnect()
				if onEnd then onEnd() end
			end
		end)
	end)
end

function Library:MakeDraggable(frame, handle)
	handle.InputBegan:Connect(function(input)
		if not IsPointer(input) then return end
		local start = Vector2.new(input.Position.X, input.Position.Y)
		local origin = frame.Position
		Library:ClosePopups()
		local mc, ec
		mc = UserInputService.InputChanged:Connect(function(i)
			if IsMove(i) then
				local d = (Vector2.new(i.Position.X, i.Position.Y) - start) / Library.DPIScale
				frame.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
			end
		end)
		ec = UserInputService.InputEnded:Connect(function(i)
			if IsPointer(i) then mc:Disconnect(); ec:Disconnect() end
		end)
	end)
end

