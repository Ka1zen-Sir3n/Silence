local function Validate(info, template)
	info = type(info) == "table" and info or {}
	for k, v in pairs(template) do
		if info[k] == nil then info[k] = v end
	end
	return info
end
Library.Validate = Validate

function Library:_Derive()
	local S = self.Scheme
	S.DarkColor = S.BackgroundColor:Lerp(Color3.new(0, 0, 0), 0.35)
	S.DimFontColor = S.FontColor:Lerp(S.BackgroundColor, 0.45)
	S.HoverColor = S.MainColor:Lerp(S.FontColor, 0.12)
	S.AccentDark = S.AccentColor:Lerp(Color3.new(0, 0, 0), 0.4)
	S.BoldFont = BoldMap[S.Font] or S.Font
end
Library:_Derive()

function Library:CardTransparency()
	return math.clamp(self.Glass + 0.25, 0, 0.95)
end

local function ApplyEntry(entry)
	local inst = entry.Instance
	for prop, key in pairs(entry.Props) do
		local value
		if type(key) == "function" then
			local ok, res = pcall(key)
			value = ok and res or nil
		else
			value = Library.Scheme[key]
		end
		if value ~= nil then pcall(function() inst[prop] = value end) end
	end
end

function Library:Register(inst, props)
	local entry = { Instance = inst, Props = props }
	table.insert(self.Registry, entry)
	ApplyEntry(entry)
	inst.Destroying:Connect(function()
		if Library.Unloaded then return end
		local i = table.find(Library.Registry, entry)
		if i then table.remove(Library.Registry, i) end
	end)
	return entry
end

function Library:UpdateColors()
	self:_Derive()
	for _, entry in ipairs(self.Registry) do ApplyEntry(entry) end
end

function Library:SetTheme(theme)
	for k, v in pairs(theme) do
		if k == "Glass" then self.Glass = v else self.Scheme[k] = v end
	end
	self:UpdateColors()
end

function Library:SetFont(font)
	self.Scheme.Font = font
	self:UpdateColors()
end

function Library:SetGlass(v)
	self.Glass = math.clamp(v, 0, 0.9)
	self:UpdateColors()
end

