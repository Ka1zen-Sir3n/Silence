function Library:Notify(info, time)
	if type(info) == "string" then info = { Description = info, Time = time } end
	info = Validate(info, { Title = "Silence", Description = "", Time = 5, Persist = false })
	local right = self.NotifySide ~= "Left"
	NotifyHolder.AnchorPoint = Vector2.new(right and 1 or 0, 0)
	NotifyHolder.Position = right and UDim2.new(1, -16, 0, 16) or UDim2.new(0, 16, 0, 16)
	NotifyList.HorizontalAlignment = right and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left

	local wrapper = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ClipsDescendants = true, Parent = NotifyHolder })
	Pad(wrapper, 2)
	local card = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(right and 1.2 or -1.2, 0, 0, 0), BackgroundTransparency = 0.08,
		Scheme = { BackgroundColor3 = "BackgroundColor" }, Parent = wrapper,
	})
	Corner(card, 10); Stroke(card, "OutlineColor", 0.35); Pad(card, 12, 10); List(card, 4)
	local title = New("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = info.Title, TextWrapped = true, TextSize = 14, Scheme = { Font = "BoldFont" }, LayoutOrder = 1, Parent = card })
	local desc
	if info.Description ~= "" then
		desc = New("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = info.Description, TextWrapped = true, TextSize = 13, Scheme = { TextColor3 = "DimFontColor" }, LayoutOrder = 2, Parent = card })
	end
	local barBack = New("Frame", { Size = UDim2.new(1, 0, 0, 3), Scheme = { BackgroundColor3 = "DarkColor" }, LayoutOrder = 3, Parent = card })
	Corner(barBack, "full")
	local bar = New("Frame", { Size = UDim2.fromScale(1, 1), Scheme = { BackgroundColor3 = "AccentColor" }, Parent = barBack })
	Corner(bar, "full")
	if info.Persist then barBack.Visible = false end

	local N = { Destroyed = false }
	function N:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true
		Library:Tween(card, { Position = UDim2.new(right and 1.2 or -1.2, 0, 0, 0) }, 0.25)
		task.delay(0.28, function() wrapper:Destroy() end)
	end
	function N:ChangeTitle(t) title.Text = t end
	function N:ChangeDescription(t) if desc then desc.Text = t end end
	Library:Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.25)
	if not info.Persist then
		Library:Tween(bar, { Size = UDim2.fromScale(0, 1) }, info.Time).Completed:Connect(function() N:Destroy() end)
	end
	return N
end

