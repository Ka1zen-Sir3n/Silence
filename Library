local NotifyHolder = New("Frame", {
	BackgroundTransparency = 1, Size = UDim2.new(0, 300, 1, -32), Position = UDim2.new(1, -16, 0, 16),
	AnchorPoint = Vector2.new(1, 0), ZIndex = 40, Parent = Overlay,
