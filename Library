function Silence:MakeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    self.Connections[#self.Connections+1] = frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.Window.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    self.Connections[#self.Connections+1] = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                local delta = input.Position - dragStart
                self.Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)
end

-- // Tabs & Components \\ --
function Silence:CreateTab(name)
    local T = Silence.Theme
    local tab = { Name = name, Components = {} }

    local btn = Create("TextButton", {
        Parent = self.Sidebar,
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Glass,
        BackgroundTransparency = 1,
        Text = "  " .. name,
        TextColor3 = T.TextMuted,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false
    })
    AddCorner(btn, 6)

    local page = Create("ScrollingFrame", {
        Parent = self.Content,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = T.Stroke,
        Visible = false,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0)
    })
    Create("UIListLayout", { Parent = page, Padding = UDim.new(0, 8) })
    AddPadding(page, 0, 8, 0, 0)

    tab.Button = btn
    tab.Page = page

    btn.MouseEnter:Connect(function() if self.ActiveTab ~= tab then Tween(btn, 0.2, { BackgroundTransparency = 0.6, TextColor3 = T.Text }).Play() end end)
    btn.MouseLeave:Connect(function() if self.ActiveTab ~= tab then Tween(btn, 0.2, { BackgroundTransparency = 1, TextColor3 = T.TextMuted }).Play() end end)
    btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

    table.insert(self.Tabs, tab)
    if not self.ActiveTab then self:SelectTab(tab) end
    return tab
end

function Silence:SelectTab(tab)
    if self.ActiveTab == tab then return end
    local T = Silence.Theme
    if self.ActiveTab then
        Tween(self.ActiveTab.Button, 0.2, { BackgroundTransparency = 1, TextColor3 = T.TextMuted }).Play()
        self.ActiveTab.Page.Visible = false
    end
    self.ActiveTab = tab
    Tween(tab.Button, 0.2, { BackgroundTransparency = 0.5, TextColor3 = T.Text }).Play()
    tab.Page.Visible = true
end

