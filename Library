function Silence:Toggle(tab, opts)
    local T = Silence.Theme
    local state = opts.Default or false

    local row = Create("Frame", { Parent = tab.Page, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 })
    Create("TextLabel", {
        Parent = row, Size = UDim2.new(1, -30, 1, 0), BackgroundTransparency = 1,
        Text = opts.Text or "Toggle", TextColor3 = T.Text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left
    })

    local box = Create("TextButton", {
        Parent = row, Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -18, 0.5, -9),
        BackgroundColor3 = state and T.GlassHover or T.Glass, BackgroundTransparency = 0.2,
        Text = state and "✓" or "", TextColor3 = T.Text, Font = Enum.Font.GothamBold, TextSize = 12, AutoButtonColor = false
    })
    AddCorner(box, 4)
    AddStroke(box, 0.8)

    box.MouseButton1Click:Connect(function()
        state = not state
        Tween(box, 0.15, { BackgroundColor3 = state and T.GlassHover or T.Glass }).Play()
        box.Text = state and "✓" or ""
        if opts.Callback then opts.Callback(state) end
    end)
    return row, function() return state end
end

function Silence:Slider(tab, opts)
    local T = Silence.Theme
    local min, max = opts.Min or 0, opts.Max or 100
    local value = opts.Default or min

    local holder = Create("Frame", { Parent = tab.Page, Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 })
    Create("TextLabel", {
        Parent = holder, Size = UDim2.new(0.7, 0, 0, 20), BackgroundTransparency = 1,
        Text = opts.Text or "Slider", TextColor3 = T.Text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left
    })
    local valLabel = Create("TextLabel", {
        Parent = holder, Size = UDim2.new(0.3, 0, 0, 20), Position = UDim2.new(0.7, 0, 0, 0), BackgroundTransparency = 1,
        Text = tostring(value) .. (opts.Suffix or ""), TextColor3 = T.TextMuted, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right
    })

    local track = Create("Frame", {
        Parent = holder, Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0, 28),
        BackgroundColor3 = T.Glass, BackgroundTransparency = 0.2, BorderSizePixel = 0
    })
    AddCorner(track, 2)

    local fill = Create("Frame", { Parent = track, Size = UDim2.new((value - min) / (max - min), 0, 1, 0), BackgroundColor3 = T.Text, BorderSizePixel = 0 })
    AddCorner(fill, 2)
    local knob = Create("Frame", {
        Parent = track, Size = UDim2.fromOffset(10, 10), Position = UDim2.new((value - min) / (max - min), -5, 0.5, -5),
        BackgroundColor3 = T.Text, BorderSizePixel = 0, ZIndex = 3
    })
    AddCorner(knob, 5)

    local dragging = false
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = min + (max - min) * rel
        if opts.Round then value = math.floor(value + 0.5) end
        valLabel.Text = tostring(value) .. (opts.Suffix or "")
        Tween(fill, 0.05, { Size = UDim2.new(rel, 0, 1, 0) }).Play()
        Tween(knob, 0.05, { Position = UDim2.new(rel, -5, 0.5, -5) }).Play()
        if opts.Callback then opts.Callback(value) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input.Position.X)
            local move, up
            move = UserInputService.InputChanged:Connect(function(m)
                if m.UserInputType == Enum.UserInputType.MouseMovement and dragging then update(m.Position.X) end
            end)
            up = UserInputService.InputEnded:Connect(function(e)
                if e.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    move:Disconnect()
                    up:Disconnect()
                end
            end)
        end
    end)
    return holder, function() return value end
end

function Silence:Dropdown(tab, opts)
    local T = Silence.Theme
    local items = opts.Items or {}
    local selected = opts.Default or items[1] or "None"

    local holder = Create("Frame", { Parent = tab.Page, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 })
    Create("TextLabel", {
        Parent = holder, Size = UDim2.new(1, -100, 1, 0), BackgroundTransparency = 1,
        Text = opts.Text or "Dropdown", TextColor3 = T.Text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left
    })

    local btn = Create("TextButton", {
        Parent = holder, Size = UDim2.new(0, 90, 0, 24), Position = UDim2.new(1, -90, 0.5, -12),
        BackgroundColor3 = T.Glass, BackgroundTransparency = 0.2, Text = selected .. "  ▾",
        TextColor3 = T.Text, Font = Enum.Font.GothamMedium, TextSize = 11, AutoButtonColor = false
    })
    AddCorner(btn, 6)

    local list = Create("Frame", {
        Parent = holder, Size = UDim2.new(0, 90, 0, 0), Position = UDim2.new(1, -90, 0, 36),
        BackgroundColor3 = T.Glass, BackgroundTransparency = 0.1, Visible = false, ClipsDescendants = true, ZIndex = 5
    })
    AddCorner(list, 6)

    local layout = Create("UIListLayout", { Parent = list })
    AddPadding(list, 4, 0, 4, 0)

    local open = false
    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            list.Visible = true
            Tween(list, 0.2, { Size = UDim2.new(0, 90, 0, math.min(#items * 24, 120)) }).Play()
            btn.Text = selected .. "  ▴"
        else
            Tween(list, 0.2, { Size = UDim2.new(0, 90, 0, 0) }).Play()
            task.delay(0.2, function() list.Visible = false end)
            btn.Text = selected .. "  ▾"
        end
    end)

    for _, item in ipairs(items) do
        local opt = Create("TextButton", {
            Parent = list, Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = T.Glass, BackgroundTransparency = 1,
            Text = item, TextColor3 = T.TextMuted, Font = Enum.Font.Gotham, TextSize = 11, AutoButtonColor = false, ZIndex = 5
        })
        opt.MouseEnter:Connect(function() Tween(opt, 0.1, { BackgroundTransparency = 0.5, TextColor3 = T.Text }).Play() end)
        opt.MouseLeave:Connect(function() Tween(opt, 0.1, { BackgroundTransparency = 1, TextColor3 = T.TextMuted }).Play() end)
        opt.MouseButton1Click:Connect(function()
            selected = item
            btn.Text = selected .. "  ▾"
            open = false
            Tween(list, 0.2, { Size = UDim2.new(0, 90, 0, 0) }).Play()
            task.delay(0.2, function() list.Visible = false end)
            if opts.Callback then opts.Callback(selected) end
        end)
    end
    return holder, function() return selected end
end

function Silence:Keybind(tab, opts)
    local T = Silence.Theme
    local key = opts.Default or Enum.KeyCode.Unknown

    local holder = Create("Frame", { Parent = tab.Page, Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1 })
    Create("TextLabel", {
        Parent = holder, Size = UDim2.new(1, -60, 1, 0), BackgroundTransparency = 1,
        Text = opts.Text or "Keybind", TextColor3 = T.Text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left
    })

    local btn = Create("TextButton", {
        Parent = holder, Size = UDim2.new(0, 60, 0, 22), Position = UDim2.new(1, -60, 0.5, -11),
        BackgroundColor3 = T.Glass, BackgroundTransparency = 0.4, Text = key.Name == "Unknown" and "None" or key.Name,
        TextColor3 = T.Text, Font = Enum.Font.GothamMedium, TextSize = 11, AutoButtonColor = false
    })
    AddCorner(btn, 4)

    local listening = false
    btn.MouseButton1Click:Connect(function() listening = true; btn.Text = "..." end)
    UserInputService.InputBegan:Connect(function(input, gp)
        if not listening or gp then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            key = input.KeyCode
            btn.Text = key.Name
            listening = false
            if opts.Callback then opts.Callback(key) end
        end
    end)
    return holder
end

function Silence:Notify(opts)
    local T = Silence.Theme
    if not self.Gui then return end

    local note = Create("Frame", {
        Parent = self.Gui, Size = UDim2.fromOffset(280, 50), Position = UDim2.new(1, 300, 0, 20),
        BackgroundColor3 = T.Background, BackgroundTransparency = 0.2
    })
    AddCorner(note, 10)
    AddStroke(note, 0.8)

    Create("TextLabel", {
        Parent = note, Size = UDim2.new(1, -24, 0, 20), Position = UDim2.new(0, 12, 0, 8), BackgroundTransparency = 1,
        Text = opts.Title or "Notification", TextColor3 = T.Text, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left
    })
    Create("TextLabel", {
        Parent = note, Size = UDim2.new(1, -24, 0, 16), Position = UDim2.new(0, 12, 0, 26), BackgroundTransparency = 1,
        Text = opts.Content or "", TextColor3 = T.TextMuted, Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left
    })

    Tween(note, 0.3, { Position = UDim2.new(1, -300, 0, 20) }).Play()
    task.delay(opts.Duration or 4, function()
        Tween(note, 0.2, { Position = UDim2.new(1, 300, 0, 20) }).Play()
        task.wait(0.2)
        note:Destroy()
    end)
end

function Silence:Destroy()
    for _, conn in pairs(self.Connections) do
        if conn.Connected then conn:Disconnect() end
    end
    if self.Gui then
        self.Gui:Destroy()
    end
end

return Silence

