-- Dependency box
----------------------------------------------------------------------
function Funcs:AddDependencyBox()
	local Box = { IsDepBox = true, Dependencies = {}, Tab = self.Tab, Groupbox = self.Groupbox }
	local Holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = NextOrder(self), Visible = false, Parent = self.Container })
	List(Holder, 8)
	Box.Holder = Holder
	Box.Container = Holder
	function Box:SetupDependencies(deps) self.Dependencies = deps; self:Update() end
	function Box:Update()
		local ok = true
		for _, dep in ipairs(self.Dependencies) do
			local obj, exp = dep[1], dep[2]
			if obj then
				if obj.Type == "Dropdown" and obj.Multi then
					if not obj.Value[exp] then ok = false end
				elseif obj.Value ~= exp then ok = false end
			end
		end
		Holder.Visible = ok
	end
	setmetatable(Box, Funcs)
	table.insert(Library.DependencyBoxes, Box)
	return Box
end

----------------------------------------------------------------------
-- KeyPicker
----------------------------------------------------------------------
local function InputToKey(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.Keyboard then return input.KeyCode.Name end
	if t == Enum.UserInputType.MouseButton1 then return "MB1" end
	if t == Enum.UserInputType.MouseButton2 then return "MB2" end
	if t == Enum.UserInputType.MouseButton3 then return "MB3" end
	return nil
end

function AttachKeyPicker(host, idx, info)
	info = Validate(info, { Default = "None", Mode = "Toggle", Text = nil, Modes = { "Always", "Toggle", "Hold", "Press" }, SyncToggleState = false, NoUI = false, Callback = function() end, ChangedCallback = function() end })
	local KP = {
		Type = "KeyPicker", Value = info.Default, Mode = info.Mode, Modes = info.Modes, Toggled = false,
		Text = info.Text or host.Text or "Keybind", NoUI = info.NoUI, SyncToggleState = info.SyncToggleState and host.Type == "Toggle",
		Callback = info.Callback, Callbacks = {}, ClickCallbacks = {}, Picking = false, Host = host,
	}
	host._addons = (host._addons or 0) + 1
	local Pill = New("TextButton", {
		Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = host._addons, ZIndex = 3,
		Text = ShortKey(KP.Value), TextSize = 11, BackgroundTransparency = 0.2, Scheme = { BackgroundColor3 = "DarkColor", TextColor3 = "FontColor" }, Parent = host.Right,
	})
	Corner(Pill, 6); Stroke(Pill, "OutlineColor", 0.45); Pad(Pill, 8, 0)
	New("UISizeConstraint", { MinSize = Vector2.new(34, 18), Parent = Pill })

	function KP:Matches(input) return self.Value ~= "None" and InputToKey(input) == self.Value end
	function KP:GetState()
		if self.Mode == "Always" then return true end
		return self.Toggled
	end
	function KP:_UpdateList()
		if not self._ListLabel then
			self._ListLabel = New("TextLabel", { Size = UDim2.new(1, 0, 0, 16), TextSize = 12, Visible = false, Parent = KeybindContainer })
		end
		local show = not self.NoUI and self.Value ~= "None"
		self._ListLabel.Visible = show
		if show then
			local name = self.SyncToggleState and host.Text or self.Text
			self._ListLabel.Text = string.format("[%s] %s (%s)", ShortKey(self.Value), tostring(name), self.Mode)
			self._ListLabel.TextColor3 = self:GetState() and Library.Scheme.AccentColor or Library.Scheme.DimFontColor
		end
	end
	function KP:_SetToggled(s)
		if self.Toggled == s then return end
		self.Toggled = s
		if self.SyncToggleState and host.SetValue then host:SetValue(s) end
		Library:SafeCallback(self.Callback, s)
		for _, cb in ipairs(self.Callbacks) do Library:SafeCallback(cb, s) end
		self:_UpdateList()
	end
	function KP:SetValue(data)
		local key, mode = data[1] or self.Value, data[2] or self.Mode
		self.Value, self.Mode = key, mode
		Pill.Text = ShortKey(key)
		if mode == "Always" then self.Toggled = true else self.Toggled = self.SyncToggleState and host.Value or false end
		self:_UpdateList()
		Library:SafeCallback(info.ChangedCallback, key, mode)
		for _, cb in ipairs(self.Callbacks) do Library:SafeCallback(cb, self:GetState()) end
	end
	function KP:OnClick(fn) table.insert(self.ClickCallbacks, fn); return self end
	function KP:OnChanged(fn) table.insert(self.Callbacks, fn); return self end
	function KP:SetText(t) self.Text = t; self:_UpdateList() end

	function KP:Pick()
		if self.Picking then return end
		self.Picking = true
		Pill.Text = "..."
		local conn
		conn = UserInputService.InputBegan:Connect(function(input)
			local key = InputToKey(input)
			if not key then return end
			if key == "Escape" or key == "Backspace" then key = "None" end
			self.Picking = false
			conn:Disconnect()
			task.defer(function() self:SetValue({ key, self.Mode }) end)
		end)
	end

	function KP:_OnInput(input)
		if self.Picking or self.Value == "None" or not self:Matches(input) then return end
		if Library.ToggleKeybind == self then return end
		if self.Mode == "Toggle" then self:_SetToggled(not self.Toggled)
		elseif self.Mode == "Hold" then self:_SetToggled(true)
		elseif self.Mode == "Press" then
			Library:SafeCallback(self.Callback, true)
		end
		for _, cb in ipairs(self.ClickCallbacks) do Library:SafeCallback(cb) end
	end
	function KP:_OnInputEnded(input)
		if self.Mode == "Hold" and self:Matches(input) then self:_SetToggled(false) end
	end

	Pill.MouseButton1Click:Connect(function() KP:Pick() end)
	Pill.MouseButton2Click:Connect(function()
		if #KP.Modes <= 1 then return end
		Library:ClosePopups()
		local scale = Library.DPIScale
		local menu = New("Frame", { Size = UDim2.fromOffset(84, #KP.Modes * 26 + 8), ZIndex = 20, BackgroundTransparency = 0.04, Scheme = { BackgroundColor3 = "BackgroundColor" }, Parent = Overlay })
		Corner(menu, 10); Stroke(menu, "OutlineColor", 0.3); Pad(menu, 4); List(menu, 0)
		local popup
		local function close() if menu.Parent then menu:Destroy() end; Library:UnregisterPopup(popup) end
		for i, mode in ipairs(KP.Modes) do
			local b = New("TextButton", { Size = UDim2.new(1, 0, 0, 26), Text = mode, TextSize = 12, LayoutOrder = i, Scheme = { TextColor3 = function() return KP.Mode == mode and Library.Scheme.AccentColor or Library.Scheme.FontColor end }, Parent = menu })
			Corner(b, 6)
			b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.88; b.BackgroundColor3 = Library.Scheme.FontColor end)
			b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
			b.MouseButton1Click:Connect(function() KP:SetValue({ KP.Value, mode }); close() end)
		end
		local p = Pill.AbsolutePosition
		menu.Position = UDim2.fromOffset((p.X + Pill.AbsoluteSize.X) / scale - 84, (p.Y + Pill.AbsoluteSize.Y + 4) / scale)
		popup = { Frame = menu, Anchor = Pill, Close = close }
		Library:RegisterPopup(popup)
	end)

	table.insert(Library.KeyPickers, KP)
	host.KeyPicker = KP
	if KP.SyncToggleState then KP.Toggled = host.Value end
	if KP.Mode == "Always" then KP.Toggled = true end
	KP:_UpdateList()
	if idx then Library.Options[idx] = KP; KP.Idx = idx end
	return KP
end

Library:GiveSignal(UserInputService.InputBegan:Connect(function(input, gpe)
	if Library.Unloaded then return end
	-- menu toggle key
	local tk = Library.ToggleKeybind
	if not UserInputService:GetFocusedTextBox() then
		if type(tk) == "table" and tk.Type == "KeyPicker" then
			if not tk.Picking and tk:Matches(input) then Library:Toggle() end
		elseif typeof(tk) == "EnumItem" then
			if input.KeyCode == tk then Library:Toggle() end
		end
	end
	-- popups: click outside closes
	if IsPointer(input) and #Library.Popups > 0 then
		for i = #Library.Popups, 1, -1 do
			local p = Library.Popups[i]
			if p and not Library:IsMouseOver(p.Frame) and not (p.Anchor and Library:IsMouseOver(p.Anchor)) then p.Close() end
		end
	end
	-- keypickers
	if UserInputService:GetFocusedTextBox() then return end
	for _, kp in ipairs(Library.KeyPickers) do
		if not (gpe and input.UserInputType ~= Enum.UserInputType.Keyboard) then kp:_OnInput(input) end
	end
end))
Library:GiveSignal(UserInputService.InputEnded:Connect(function(input)
	if Library.Unloaded then return end
	for _, kp in ipairs(Library.KeyPickers) do kp:_OnInputEnded(input) end
end))

----------------------------------------------------------------------
-- ColorPicker
----------------------------------------------------------------------
function AttachColorPicker(host, idx, info)
	info = Validate(info, { Default = Color3.new(1, 1, 1), Title = "Color", Callback = function() end })
	local CP = {
		Type = "ColorPicker", Value = info.Default, Transparency = info.Transparency or 0,
		HasTransparency = info.Transparency ~= nil, Title = info.Title, Callback = info.Callback, Callbacks = {},
	}
	CP.Hue, CP.Sat, CP.Vib = info.Default:ToHSV()
	host._addons = (host._addons or 0) + 1
	local Swatch = New("TextButton", { Size = UDim2.fromOffset(20, 18), LayoutOrder = host._addons, ZIndex = 3, BackgroundColor3 = CP.Value, Parent = host.Right })
	Corner(Swatch, 6); Stroke(Swatch, "OutlineColor", 0.2)

	local Pop, PopConn, Popup
	local SV, SVCursor, HueMarker, AlphaMarker, AlphaBar, Hex, HueBar
	local function refreshVisuals()
		Swatch.BackgroundColor3 = CP.Value
		Swatch.BackgroundTransparency = CP.Transparency * 0.8
		if Pop then
			SV.BackgroundColor3 = Color3.fromHSV(CP.Hue, 1, 1)
			SVCursor.Position = UDim2.fromScale(CP.Sat, 1 - CP.Vib)
			HueMarker.Position = UDim2.new(CP.Hue, 0, 0.5, 0)
			if AlphaBar then
				AlphaBar.BackgroundColor3 = CP.Value
				AlphaMarker.Position = UDim2.new(1 - CP.Transparency, 0, 0.5, 0)
			end
			if not Hex:IsFocused() then Hex.Text = CP.Value:ToHex() end
		end
	end
	function CP:Display() refreshVisuals() end
	local function fire()
		CP.Value = Color3.fromHSV(CP.Hue, CP.Sat, CP.Vib)
		refreshVisuals()
		Library:SafeCallback(CP.Callback, CP.Value)
		for _, cb in ipairs(CP.Callbacks) do Library:SafeCallback(cb, CP.Value) end
	end
	function CP:SetHSVValue(h, s, v, t)
		self.Hue, self.Sat, self.Vib = h, s, v
		if t ~= nil then self.Transparency = t end
		fire()
	end
	function CP:SetValueRGB(c, t)
		local h, s, v = c:ToHSV()
		self:SetHSVValue(h, s, v, t)
	end
	function CP:SetValue(v, t)
		if typeof(v) == "Color3" then self:SetValueRGB(v, t)
		elseif type(v) == "table" then self:SetHSVValue(v[1], v[2], v[3], t) end
	end
	function CP:OnChanged(fn) table.insert(self.Callbacks, fn); return self end

	local function close()
		if not Pop then return end
		if PopConn then PopConn:Disconnect(); PopConn = nil end
		Pop:Destroy(); Pop = nil
		Library:UnregisterPopup(Popup); Popup = nil
	end
	local function open()
		if Pop then close(); return end
		Library:ClosePopups()
		local scale = Library.DPIScale
		Pop = New("Frame", { Size = UDim2.new(0, 230, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 20, BackgroundTransparency = 0.04, Scheme = { BackgroundColor3 = "BackgroundColor" }, Parent = Overlay })
		Corner(Pop, 12); Stroke(Pop, "OutlineColor", 0.3); Pad(Pop, 10); List(Pop, 8)
		New("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Text = CP.Title, TextSize = 13, Scheme = { Font = "BoldFont" }, LayoutOrder = 1, Parent = Pop })

		SV = New("Frame", { Size = UDim2.new(1, 0, 0, 120), LayoutOrder = 2, BackgroundColor3 = Color3.fromHSV(CP.Hue, 1, 1), Parent = Pop })
		Corner(SV, 8)
		local white = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = SV })
		Corner(white, 8)
		New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
		local black = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Parent = SV })
		Corner(black, 8)
		New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
		SVCursor = New("Frame", { Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 3, Parent = SV })
		Corner(SVCursor, "full")
		New("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Parent = SVCursor })
		local SVHit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = SV })
		Dragify(SVHit, function(pos)
			CP.Sat = math.clamp((pos.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
			CP.Vib = 1 - math.clamp((pos.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
			fire()
		end)

		HueBar = New("Frame", { Size = UDim2.new(1, 0, 0, 12), LayoutOrder = 3, BackgroundColor3 = Color3.new(1, 1, 1), Parent = Pop })
		Corner(HueBar, "full")
		New("UIGradient", { Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)), ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)), ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)) }), Parent = HueBar })
		HueMarker = New("Frame", { Size = UDim2.fromOffset(6, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(CP.Hue, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), Parent = HueBar })
		Corner(HueMarker, 3); Stroke(HueMarker, "OutlineColor", 0)
		local HueHit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = HueBar })
		Dragify(HueHit, function(pos)
			CP.Hue = math.clamp((pos.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X, 0, 1)
			fire()
		end)

		AlphaBar, AlphaMarker = nil, nil
		if CP.HasTransparency then
			local back = New("Frame", { Size = UDim2.new(1, 0, 0, 12), LayoutOrder = 4, Scheme = { BackgroundColor3 = "DarkColor" }, Parent = Pop })
			Corner(back, "full")
			AlphaBar = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = CP.Value, Parent = back })
			Corner(AlphaBar, "full")
			New("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = AlphaBar })
			AlphaMarker = New("Frame", { Size = UDim2.fromOffset(6, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1 - CP.Transparency, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), Parent = back })
			Corner(AlphaMarker, 3); Stroke(AlphaMarker, "OutlineColor", 0)
			local AHit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = back })
			Dragify(AHit, function(pos)
				CP.Transparency = 1 - math.clamp((pos.X - back.AbsolutePosition.X) / back.AbsoluteSize.X, 0, 1)
				fire()
			end)
		end

		local HexBox = New("Frame", { Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 5, BackgroundTransparency = 0.2, Scheme = { BackgroundColor3 = "DarkColor" }, Parent = Pop })
		Corner(HexBox, 8); Stroke(HexBox, "OutlineColor", 0.45)
		New("TextLabel", { Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(16, 26), Text = "#", TextSize = 13, Scheme = { TextColor3 = "DimFontColor" }, Parent = HexBox })
		Hex = New("TextBox", { Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -34, 1, 0), Text = CP.Value:ToHex(), TextSize = 13, Parent = HexBox })
		Hex.FocusLost:Connect(function()
			local ok, c = pcall(Color3.fromHex, Hex.Text)
			if ok and c then CP:SetValueRGB(c) else Hex.Text = CP.Value:ToHex() end
		end)

		local function position()
			local p, s = Swatch.AbsolutePosition, Swatch.AbsoluteSize
			local x = math.clamp(p.X + s.X, 240 * scale, Overlay.AbsoluteSize.X)
			local y = p.Y + s.Y + 6
			local h = Pop.AbsoluteSize.Y
			if y + h > Overlay.AbsoluteSize.Y then y = math.max(0, p.Y - h - 6) end
			Pop.Position = UDim2.fromOffset((x - 230 * scale) / scale, y / scale)
		end
		position()
		Popup = { Frame = Pop, Anchor = Swatch, Close = close }
		Library:RegisterPopup(Popup)
		PopConn = RunService.RenderStepped:Connect(function()
			if not Pop then return end
			if not Library:IsVisible(Swatch) then close(); return end
			position()
		end)
		refreshVisuals()
	end
	Swatch.MouseButton1Click:Connect(open)
	if info.Tooltip then CP.TooltipObj = Library:AddTooltip(info.Tooltip, Swatch) end

	host.ColorPicker = CP
	refreshVisuals()
	if idx then Library.Options[idx] = CP; CP.Idx = idx end
	return CP
end

----------------------------------------------------------------------
-- Groupbox / Tabbox
----------------------------------------------------------------------
local function CardFrame(parent, order)
	local F = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order,
		Scheme = { BackgroundColor3 = "MainColor", BackgroundTransparency = function() return Library:CardTransparency() end }, Parent = parent,
	})
	Corner(F, 12); Stroke(F, "OutlineColor", 0.5)
	List(F, 0)
	return F
end

local function ResolveIcon(icon)
	if not icon then return nil end
	if type(icon) == "number" then return { Image = "rbxassetid://" .. icon } end
	if type(icon) == "string" then return { Image = icon } end
	if type(icon) == "table" then return icon end
end

local function ApplyIcon(img, icon)
	local r = ResolveIcon(icon)
	if not r then return false end
	img.Image = r.Url or r.Image or ""
	if r.ImageRectOffset then img.ImageRectOffset = r.ImageRectOffset end
	if r.ImageRectSize then img.ImageRectSize = r.ImageRectSize end
	return true
end

local function CreateGroupbox(tab, side, name, icon)
	local scroll = side == 1 and tab.Left or tab.Right
	tab._gbOrder = (tab._gbOrder or 0) + 1
	local G = { Name = name, NameLower = string.lower(name), Tab = tab, Side = side, Visible = true, Collapsed = false, _anyMatch = true }
	G.Frame = CardFrame(scroll, tab._gbOrder)
	local Header = New("TextButton", { Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 1, Parent = G.Frame })
	local tx = 14
	if icon then
		local I = New("ImageLabel", { Position = UDim2.new(0, 14, 0.5, -8), Size = UDim2.fromOffset(16, 16), Scheme = { ImageColor3 = "AccentColor" }, Parent = Header })
		if ApplyIcon(I, icon) then tx = 38 else I:Destroy() end
	end
	New("TextLabel", { Position = UDim2.fromOffset(tx, 0), Size = UDim2.new(1, -tx - 40, 1, 0), Text = name, TextSize = 14, Scheme = { Font = "BoldFont" }, Parent = Header })
	local Arrow = Chevron(Header)
	Arrow.Position = UDim2.new(1, -20, 0.5, 0)
	local Divider = New("Frame", { Size = UDim2.new(1, 0, 0, 1), LayoutOrder = 2, BackgroundTransparency = 0.6, Scheme = { BackgroundColor3 = "OutlineColor" }, Parent = G.Frame })
	local Body = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = G.Frame })
	Pad(Body, 12, 10); List(Body, 8)
	G.Container = Body
	G.Groupbox = G
	function G:Collapse(c)
		self.Collapsed = c and true or false
		Body.Visible = not self.Collapsed
		Divider.Visible = not self.Collapsed
		Library:Tween(Arrow, { Rotation = self.Collapsed and -90 or 0 })
		Library:ClosePopups()
	end
	function G:SetVisible(v) self.Visible = v and true or false; self.Frame.Visible = self.Visible end
	function G:Resize() end
	Header.MouseButton1Click:Connect(function() G:Collapse(not G.Collapsed) end)
	setmetatable(G, Funcs)
	table.insert(Library.Groupboxes, G)
	table.insert(tab.Groupboxes, G)
	return G
end

local function CreateTabbox(tab, side)
	local scroll = side == 1 and tab.Left or tab.Right
	tab._gbOrder = (tab._gbOrder or 0) + 1
	local TB = { IsTabbox = true, Tabs = {}, Tab = tab, Visible = true }
	TB.Frame = CardFrame(scroll, tab._gbOrder)
	local Header = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 1, Parent = TB.Frame })
	List(Header, 0, Enum.FillDirection.Horizontal)
	New("Frame", { Size = UDim2.new(1, 0, 0, 1), LayoutOrder = 2, BackgroundTransparency = 0.6, Scheme = { BackgroundColor3 = "OutlineColor" }, Parent = TB.Frame })
	local Content = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = TB.Frame })

	function TB:AddTab(name)
		local T = { Name = name, Tab = tab, Groupbox = TB, Visible = true }
		local Btn = New("TextButton", { Size = UDim2.new(1, 0, 1, 0), Text = name, TextSize = 13, LayoutOrder = #TB.Tabs + 1, Parent = Header, Scheme = { TextColor3 = function() return TB.Active == T and Library.Scheme.FontColor or Library.Scheme.DimFontColor end } })
		local Line = New("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0.6, 0, 0, 2), Visible = false, Scheme = { BackgroundColor3 = "AccentColor" }, Parent = Btn })
		Corner(Line, "full")
		local Body = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, Parent = Content })
		Pad(Body, 12, 10); List(Body, 8)
		T.Container, T.Body, T.Button, T.Line = Body, Body, Btn, Line
		function T:Show()
			for _, o in ipairs(TB.Tabs) do o.Body.Visible = false; o.Line.Visible = false end
			TB.Active = T
			Body.Visible = true; Line.Visible = true
			Library:UpdateColors()
			Library:ClosePopups()
		end
		function T:Hide() Body.Visible = false; Line.Visible = false end
		Btn.MouseButton1Click:Connect(function() T:Show() end)
		setmetatable(T, Funcs)
		table.insert(TB.Tabs, T)
		local n = #TB.Tabs
		for _, o in ipairs(TB.Tabs) do o.Button.Size = UDim2.new(1 / n, 0, 1, 0) end
		if n == 1 then T:Show() end
		return T
	end
	function TB:SetVisible(v) self.Frame.Visible = v end
	table.insert(tab.Tabboxes, TB)
	return TB
end

----------------------------------------------------------------------
-- Toggle visibility, blur
----------------------------------------------------------------------
function Library:SetBackgroundBlur(enabled, size)
	self.BlurEnabled = enabled and true or false
	if size then self.BlurSize = size end
	self:_UpdateBlur()
end

function Library:_UpdateBlur()
	if not self.Blur then
		self.Blur = Instance.new("BlurEffect")
		self.Blur.Name = "SilenceBlur"
		self.Blur.Size = 0
		self.Blur.Parent = Lighting
	end
	self:Tween(self.Blur, { Size = (self.Toggled and self.BlurEnabled) and self.BlurSize or 0 }, 0.25)
end

function Library:Toggle(v)
	if v == nil then v = not self.Toggled end
	self.Toggled = v and true or false
	if self.Window then
		self.Window.Main.Visible = self.Toggled
		if self.ModalButton then self.ModalButton.Modal = self.Toggled end
	end
	if not self.Toggled then self:ClosePopups(); TipFrame.Visible = false end
	self:_UpdateBlur()
end

function Library:Unload()
	if self.Unloaded then return end
	for _, cb in ipairs(self.UnloadCallbacks) do pcall(cb) end
	self.Unloaded = true
	for _, c in ipairs(self.Signals) do pcall(function() c:Disconnect() end) end
	pcall(function() UserInputService.MouseIconEnabled = OriginalMouseIcon end)
	if self.Blur then pcall(function() self.Blur:Destroy() end) end
	pcall(function() ScreenGui:Destroy() end)
	if genv.Silence == self then genv.Silence = nil end
end

