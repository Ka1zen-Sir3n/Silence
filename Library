function Library:UpdateDependencyBoxes()
	for _, box in ipairs(self.DependencyBoxes) do box:Update() end
end

function Library:Search(text)
	text = string.lower(text or "")
	self.SearchText = text
	self.Searching = text ~= ""
	for _, g in ipairs(self.Groupboxes) do g._anyMatch = false end
	for _, item in ipairs(self.SearchItems) do
		local hidden = false
		if self.Searching then
			local gname = item.Groupbox and item.Groupbox.NameLower or ""
			hidden = not (string.find(item.Text, text, 1, true) or string.find(gname, text, 1, true))
		end
		item.Obj._searchHidden = hidden
		item.Obj.Holder.Visible = item.Obj.Visible and not hidden
		if item.Groupbox and not hidden then item.Groupbox._anyMatch = true end
	end
	for _, g in ipairs(self.Groupboxes) do
		g.Frame.Visible = g.Visible and (not self.Searching or g._anyMatch)
	end
end

