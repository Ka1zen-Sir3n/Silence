-- Slider
----------------------------------------------------------------------
function Funcs:AddSlider(idx, info)
	info = Validate(info, { Text = "Slider", Default = 0, Min = 0, Max = 100, Rounding = 0, Prefix = "", Suffix = "", Compact = false, HideMax = true, Callback = function() end, Disabled = false, Visible = true })
	local Slider = { Type = "Slider", Min = info.Min, Max = info.Max, Rounding = info.Rounding, Prefix = info.Prefix, Suffix = info.Suffix, Text = info.Text }
	local mult = 10 ^ Slider.Rounding
	local function clean(v)
		v = math.clamp(v, Slider.Min, Slider.Max)
		return math.floor(v * mult + 0.5) / mult
	end
	Slider.Value = clean(info.Default)

	local Holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, info.Compact and 22 or 40), LayoutOrder = NextOrder(self), Parent = self.Container })
	local Label, ValueLabel
	if not info.Compact then
		Label = New("TextLabel", { Size = UDim2.new(0.65, 0, 0, 18), Text = info.Text, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Holder })
		ValueLabel = New("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.35, 0, 0, 18), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Scheme = { TextColor3 = "DimFontColor" }, Parent = Holder })
	end
	local barY = info.Compact and 8 or 26
	local Bar = New("Frame", { Position = UDim2.new(0, 7, 0, barY), Size = UDim2.new(1, -14, 0, 6), Scheme = { BackgroundColor3 = "DarkColor" }, Parent = Holder })
	Corner(Bar, "full")
	local Fill = New("Frame", { Size = UDim2.fromScale(0, 1), Scheme = { BackgroundColor3 = "AccentColor" }, Parent = Bar })
	Corner(Fill, "full")
	local Knob = New("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2, Parent = Bar })
	Corner(Knob, "full"); Stroke(Knob, "AccentColor", 0, 2)
	local Hit = New("TextButton", { Position = UDim2.new(0, 0, 0, info.Compact and 0 or 18), Size = UDim2.new(1, 0, 1, info.Compact and 0 or -18), ZIndex = 3, Parent = Holder })

	function Slider:Display()
		local range = self.Max - self.Min
		local a = range == 0 and 0 or (self.Value - self.Min) / range
		Fill.Size = UDim2.fromScale(a, 1)
		Knob.Position = UDim2.fromScale(a, 0.5)
		local txt = self.Rounding > 0 and string.format("%." .. self.Rounding .. "f", self.Value) or tostring(math.floor(self.Value + 0.5))
		local full = self.Prefix .. txt .. self.Suffix
		if not info.HideMax then full = full .. " / " .. tostring(self.Max) end
		if ValueLabel then ValueLabel.Text = full end
		if info.Compact and Label == nil then end
	end
	function Slider:SetValue(v)
		v = clean(tonumber(v) or self.Value)
		if v == self.Value then return end
		self.Value = v
		self:Display()
		self:_Fire(v)
	end
	function Slider:SetMax(m) self.Max = m; self.Value = clean(self.Value); self:Display() end
	function Slider:SetMin(m) self.Min = m; self.Value = clean(self.Value); self:Display() end
	function Slider:SetText(t) self.Text = t; if Label then Label.Text = t end end
	function Slider:SetPrefix(p) self.Prefix = p; self:Display() end
	function Slider:SetSuffix(s) self.Suffix = s; self:Display() end
	function Slider:SetDisabled(d) self.Disabled = d and true or false; Knob.Visible = not self.Disabled or true; if Label then Label.TextTransparency = self.Disabled and 0.6 or 0 end end

	InitElement(self, Slider, Holder, info.Text, info)
	Dragify(Hit, function(pos)
		if Slider.Disabled then return end
		local a = math.clamp((pos.X - Bar.AbsolutePosition.X) / math.max(Bar.AbsoluteSize.X, 1), 0, 1)
		Slider:SetValue(Slider.Min + (Slider.Max - Slider.Min) * a)
	end)
	if info.Tooltip then Slider.TooltipObj = Library:AddTooltip(info.Tooltip, Hit) end
	Slider:SetDisabled(info.Disabled)
	Slider:Display()
	Register(idx, Slider)
	return Slider
end

