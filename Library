    local selectedLabel = New("TextLabel", {
        Parent = holder,
        Size = UDim2.new(1, -48, 0, 36),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = (opts.Text and opts.Text .. "  ·  " or "") .. tostring(selected),
        TextColor3 = T.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
    })
    local arrow = New("TextLabel", {
        Parent = holder,
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, -26, 0.5, -8),
        BackgroundTransparency = 1,
        Text = "▾",
        TextColor3 = T.TextMuted,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        ZIndex = 3,
    })

    local list = New("Frame", {
        Parent = holder,
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 36),
        BackgroundColor3 = T.Surface,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 4,
    })

    local listPad = New("UIPadding", {
        Parent = list,
        PaddingTop = UDim.new(0, 6),
        PaddingBottom = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 6),
    })
    New("UIListLayout", {
        Parent = list,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    for _, item in ipairs(items) do
        local opt = New("TextButton", {
            Parent = list,
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = T.Surface,
            BackgroundTransparency = 1,
            Text = tostring(item),
            TextColor3 = T.TextMuted,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4,
        })
        Padding(opt, 0, 0, 0, 10)
        Corner(opt, 7)
        opt.MouseEnter:Connect(function()
            Tween(opt, 0.12, { BackgroundTransparency = 0.5, TextColor3 = T.Text }).Play()
        end)
        opt.MouseLeave:Connect(function()
            Tween(opt, 0.12, { BackgroundTransparency = 1, TextColor3 = T.TextMuted }).Play()
        end)
        opt.MouseButton1Click:Connect(function()
            selected = item
            selectedLabel.Text = (opts.Text and opts.Text .. "  ·  " or "") .. tostring(item)
            Tween(holder, 0.22, { Size = UDim2.new(1, 0, 0, 36) }, Enum.EasingStyle.Quart).Play()
            task.delay(0.18, function() list.Visible = false end)
            Tween(arrow, 0.2, { Rotation = 0 }).Play()
            if opts.Callback then opts.Callback(item) end
        end)
    end

    local click = New("TextButton", {
        Parent = holder,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 5,
    })
    local open = false
    click.MouseButton1Click:Connect(function()
        open = not open
        if open then
            local h = 36 + math.min(#items * 30 + 12, 220)
            Tween(holder, 0.24, { Size = UDim2.new(1, 0, 0, h) }, Enum.EasingStyle.Quart).Play()
            list.Visible = true
            Tween(arrow, 0.2, { Rotation = 180 }).Play()
        else
            Tween(holder, 0.22, { Size = UDim2.new(1, 0, 0, 36) }, Enum.EasingStyle.Quart).Play()
            task.delay(0.18, function() list.Visible = false end)
            Tween(arrow, 0.2, { Rotation = 0 }).Play()
        end
    end)

    register(self, tab, holder, opts.Text or "Dropdown")
    return holder, function() return selected end
end

