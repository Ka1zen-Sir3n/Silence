function Silence:MakeDraggable(frame)
    local dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            self.Dragging = true
            dragStart = input.Position
            startPos = self.Window.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    self.Dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not self.Dragging or not dragStart then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
            self.Window.Position = newPos
            self.Backdrop.Position = UDim2.new(newPos.X.Scale, newPos.X.Offset - 20,
                                               newPos.Y.Scale, newPos.Y.Offset - 20)
        end
    end)
end

function Silence:CreateTab(name)
    local T = self.Theme
    local tab = { Name = name, Components = {} }

    local btn = New("TextButton", {
        Parent = self.Sidebar,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = T.Surface,
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = T.TextMuted,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        ClipsDescendants = true,
    })
    Padding(btn, 0, 0, 0, 12)
    Corner(btn, 8)

    local page = New("ScrollingFrame", {
        Parent = self.Content,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = T.Hairline,
        ScrollBarImageTransparency = 0.3,
        Visible = false,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
    })
    New("UIPadding", {
        Parent = page,
        PaddingRight = UDim.new(0, 8),
    })
    New("UIListLayout", {
        Parent = page,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    tab.Button = btn
    tab.Page = page

    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            Tween(btn, 0.16, { BackgroundTransparency = 0.6, TextColor3 = T.Text }).Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            Tween(btn, 0.16, { BackgroundTransparency = 1, TextColor3 = T.TextMuted }).Play()
        end
    end)
    btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

    table.insert(self.Tabs, tab)
    if not self.ActiveTab then self:SelectTab(tab) end
    return tab
end

function Silence:SelectTab(tab)
    if self.ActiveTab == tab then return end
    local T = self.Theme

    if self.ActiveTab then
        local old = self.ActiveTab
        Tween(old.Button, 0.16, { BackgroundTransparency = 1, TextColor3 = T.TextMuted }).Play()
        old.Page.Visible = false
    end

    self.ActiveTab = tab
    Tween(tab.Button, 0.18, { BackgroundTransparency = 0.4, TextColor3 = T.Text }).Play()

    tab.Page.Visible = true
    tab.Page.Position = UDim2.new(0, 0, 0, 6)
    tab.Page.BackgroundTransparency = 1
    for _, d in pairs(tab.Page:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            d.TextTransparency = 0.3
        end
    end
    Tween(tab.Page, 0.28, { Position = UDim2.new(0, 0, 0, 0) }).Play()
    for _, d in pairs(tab.Page:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            Tween(d, 0.24, { TextTransparency = 0 }).Play()
        end
    end
end

function Silence:Filter(query)
    query = (query or ""):lower()
    for _, tab in ipairs(self.Tabs) do
        for _, comp in ipairs(tab.Components) do
            if comp.Instance then
                comp.Instance.Visible = query == "" or (comp.Name or ""):lower():find(query, 1, true) ~= nil
            end
        end
    end
end

local function register(self, tab, inst, name)
    table.insert(tab.Components, { Instance = inst, Name = name })
end

