    Corner(row, 10)
    Stroke(row, T.HairlineSoft, 1, 0.2)

    New("TextLabel", {
        Parent = row,
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = opts.Text or "Toggle",
        TextColor3 = T.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local track = New("Frame", {
        Parent = row,
        Size = UDim2.fromOffset(34, 18),
        Position = UDim2.new(1, -48, 0.5, -9),
        BackgroundColor3 = T.SurfaceAlt,
        BorderSizePixel = 0,
    })
    Corner(track, 9)
    local trackStroke = Stroke(track, T.HairlineSoft, 1, 0.3)

    local fill = New("Frame", {
        Parent = track,
        Size = state and UDim2.new(1, 0, 1, 0) or UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = T.Accent,
        BackgroundTransparency = state and 0 or 1,
        BorderSizePixel = 0,
    })
    Corner(fill, 9)

    local knob = New("Frame", {
        Parent = track,
        Size = UDim2.fromOffset(14, 14),
        Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = state and T.Background or T.TextFaint,
        BorderSizePixel = 0,
        ZIndex = 3,
    })
    Corner(knob, 7)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            state = not state
            Tween(knob, 0.22, {
                Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = state and T.Background or T.TextFaint,
            }, Enum.EasingStyle.Quart).Play()
            Tween(fill, 0.22, {
                Size = state and UDim2.new(1, 0, 1, 0) or UDim2.new(0, 0, 1, 0),
                BackgroundTransparency = state and 0 or 1,
            }).Play()
            if opts.Callback then opts.Callback(state) end
        end
    end)

    register(self, tab, row, opts.Text or "Toggle")
    return row, function() return state end
end

function Silence:Slider(tab, opts)
    opts = opts or {}
    local T = self.Theme
    local min = opts.Min or 0
    local max = opts.Max or 100
    local value = opts.Default or min

    local holder = New("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = T.Surface,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
    })
    Corner(holder, 10)
    Stroke(holder, T.HairlineSoft, 1, 0.2)

    New("TextLabel", {
        Parent = holder,
        Size = UDim2.new(0.7, -14, 0, 22),
        Position = UDim2.new(0, 14, 0, 6),
        BackgroundTransparency = 1,
        Text = opts.Text or "Slider",
        TextColor3 = T.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLabel = New("TextLabel", {
        Parent = holder,
        Size = UDim2.new(0.3, -14, 0, 22),
        Position = UDim2.new(0.7, 0, 0, 6),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = T.TextMuted,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local track = New("Frame", {
        Parent = holder,
        Size = UDim2.new(1, -28, 0, 4),
        Position = UDim2.new(0, 14, 0, 36),
        BackgroundColor3 = T.SurfaceAlt,
        BorderSizePixel = 0,
    })
    Corner(track, 2)
    local fill = New("Frame", {
        Parent = track,
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
    })
    Corner(fill, 2)
    local knob = New("Frame", {
        Parent = track,
        Size = UDim2.fromOffset(12, 12),
        Position = UDim2.new((value - min) / (max - min), -6, 0.5, -6),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
        ZIndex = 4,
    })
    Corner(knob, 6)

    local dragging = false
    local function setFromX(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = min + (max - min) * rel
        if opts.Round then value = math.floor(value + 0.5) end
        valLabel.Text = tostring(value)
        Tween(fill, 0.08, { Size = UDim2.new(rel, 0, 1, 0) }).Play()
        Tween(knob, 0.08, { Position = UDim2.new(rel, -6, 0.5, -6) }).Play()
        if opts.Callback then opts.Callback(value) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            setFromX(input.Position.X)
            local moveConn = UserInputService.InputChanged:Connect(function(m)
                if m.UserInputType == Enum.UserInputType.MouseMovement and dragging then
                    setFromX(m.Position.X)
                end
            end)
            local upConn
            upConn = UserInputService.InputEnded:Connect(function(e)
                if e.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    moveConn:Disconnect()
                    upConn:Disconnect()
                end
            end)
        end
    end)

    register(self, tab, holder, opts.Text or "Slider")
    return holder, function() return value end
end

