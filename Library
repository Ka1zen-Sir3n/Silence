            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
        }),
    })

    local hueKnob = New("Frame", {
        Parent = hueBar,
        Size = UDim2.fromOffset(4, 20),
        Position = UDim2.new(hue, -2, 0.5, -10),
        BackgroundColor3 = T.Text,
        BorderSizePixel = 0,
        ZIndex = 3,
    })
    Corner(hueKnob, 2)

    local function emit()
        swatch.BackgroundColor3 = Color3.fromHSV(hue, sat, val)
        if opts.Callback then opts.Callback(Color3.fromHSV(hue, sat, val)) end
    end

    local dragH = false
    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragH = true end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragH and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local rel = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
            hue = rel
            hueKnob.Position = UDim2.new(rel, -2, 0.5, -10)
            emit()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragH = false end
    end)

    register(self, tab, holder, opts.Text or "Color")
    return holder, function() return Color3.fromHSV(hue, sat, val) end
end

function Silence:Notify(opts)
    opts = opts or {}
    local T = self.Theme
    if not self.Gui then return end

    local note = New("Frame", {
        Parent = self.Gui,
        Size = UDim2.fromOffset(300, 60),
        Position = UDim2.new(1, 340, 0, 20),
        BackgroundColor3 = T.Surface,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
    })
    Corner(note, 12)
    Stroke(note, T.HairlineSoft, 1, 0.1)

    New("Frame", {
        Parent = note,
        Size = UDim2.new(0, 3, 0.5, 0),
        Position = UDim2.new(0, 12, 0.25, 0),
        BackgroundColor3 = opts.Color or T.Accent,
        BorderSizePixel = 0,
    })
    Corner(note:GetChildren()[#note:GetChildren()], 2)

    New("TextLabel", {
        Parent = note,
        Size = UDim2.new(1, -34, 0, 22),
        Position = UDim2.new(0, 24, 0, 10),
        BackgroundTransparency = 1,
        Text = opts.Title or "Notification",
        TextColor3 = T.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    New("TextLabel", {
        Parent = note,
        Size = UDim2.new(1, -34, 0, 16),
        Position = UDim2.new(0, 24, 0, 32),
        BackgroundTransparency = 1,
        Text = opts.Content or "",
        TextColor3 = T.TextMuted,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    table.insert(self.Notifications, note)
    local targetY = 20 + (#self.Notifications - 1) * 72
    Tween(note, 0.32, { Position = UDim2.new(1, -320, 0, targetY) }, Enum.EasingStyle.Quart).Play()

    task.delay(opts.Duration or 4, function()
        Tween(note, 0.28, { Position = UDim2.new(1, 340, 0, targetY), BackgroundTransparency = 1 }).Play()
        for _, c in pairs(note:GetDescendants()) do
            if c:IsA("TextLabel") or c:IsA("Frame") then
                pcall(function() Tween(c, 0.24, { BackgroundTransparency = 1, TextTransparency = 1 }).Play() end)
            end
        end
        task.wait(0.3)
        note:Destroy()
        for i, n in ipairs(self.Notifications) do
            if n == note then
                table.remove(self.Notifications, i)
                for j, other in ipairs(self.Notifications) do
                    local ny = 20 + (j - 1) * 72
                    Tween(other, 0.26, { Position = UDim2.new(1, -320, 0, ny) }).Play()
                end
                break
            end
        end
    end)
    return note
end

function Silence:SaveConfig()
    local data = {}
    for _, tab in ipairs(self.Tabs) do
        data[tab.Name] = {}
        for _, comp in ipairs(tab.Components) do
            if comp.Instance and comp.Name then
                data[tab.Name][comp.Name] = { Visible = comp.Instance.Visible }
            end
        end
    end
    if writefile and HttpService then
        writefile("SilenceConfig.json", HttpService:JSONEncode(data))
    end
    return data
end

function Silence:LoadConfig()
    if not isfile or not HttpService or not isfile("SilenceConfig.json") then return nil end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile("SilenceConfig.json"))
    end)
    if not ok then return nil end
    for _, tab in ipairs(self.Tabs) do
        local tabData = data[tab.Name]
        if tabData then
            for _, comp in ipairs(tab.Components) do
                local entry = tabData[comp.Name]
                if entry and comp.Instance then
                    comp.Instance.Visible = entry.Visible
                end
            end
        end
    end
    return data
end

function Silence:Destroy()
    Tween(self.Window, 0.28, { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }).Play()
    Tween(self.Backdrop, 0.28, { BackgroundTransparency = 1 }).Play()
    for _, d in pairs(self.Gui:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            pcall(function() Tween(d, 0.22, { TextTransparency = 1 }).Play() end)
        end
    end
    task.wait(0.3)
    self.Gui:Destroy()
end

return Silence
