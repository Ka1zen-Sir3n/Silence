    Glass = Color3.fromRGB(40, 42, 48),
    GlassHover = Color3.fromRGB(55, 58, 65),
    Stroke = Color3.fromRGB(255, 255, 255),
    Text = Color3.fromRGB(255, 255, 255),
    TextMuted = Color3.fromRGB(150, 155, 165),
    Accent = Color3.fromRGB(130, 160, 255),
    Danger = Color3.fromRGB(255, 90, 90),
    Success = Color3.fromRGB(90, 220, 120),
}

local function Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do inst[k] = v end
    return inst
end

local function Tween(obj, time, props, style)
    return TweenService:Create(obj, TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
end

local function AddCorner(parent, radius)
    return Create("UICorner", { Parent = parent, CornerRadius = UDim.new(0, radius or 8) })
end

local function AddStroke(parent, transparency, thickness)
    return Create("UIStroke", { Parent = parent, Color = Library.Scheme.Stroke, Transparency = transparency or 0.85, Thickness = thickness or 1 })
end

local function AddPadding(parent, t, r, b, l)
    return Create("UIPadding", {
        Parent = parent,
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft = UDim.new(0, l or r or t or 0)
    })
end

