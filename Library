    end)
    btn.MouseButton1Up:Connect(function()
        Tween(btn, 0.14, { BackgroundColor3 = T.SurfaceAlt }).Play()
        if opts.Callback then opts.Callback() end
    end)

    register(self, tab, btn, opts.Text or "Button")
    return btn
end

function Silence:Toggle(tab, opts)
    opts = opts or {}
    local T = self.Theme
    local state = opts.Default or false

    local row = New("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = T.Surface,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
