local Funcs = {}
Funcs.__index = Funcs

local function NextOrder(self)
	self._order = (self._order or 0) + 1
	return self._order
end

local function InitElement(self, obj, holder, searchText, info)
	obj.Holder = holder
	obj.Visible = info.Visible ~= false
	obj.Disabled = info.Disabled == true
	obj._searchHidden = false
	obj.Callbacks = {}
	obj.Callback = info.Callback
	holder.Visible = obj.Visible
	function obj:SetVisible(v) self.Visible = v and true or false; self.Holder.Visible = self.Visible and not self._searchHidden end
	function obj:OnChanged(fn) table.insert(self.Callbacks, fn); return self end
	function obj:_Fire(...)
		Library:SafeCallback(self.Callback, ...)
		for _, cb in ipairs(self.Callbacks) do Library:SafeCallback(cb, ...) end
	end
	if searchText then
		table.insert(Library.SearchItems, { Obj = obj, Text = string.lower(tostring(searchText)), Groupbox = self.Groupbox, Tab = self.Tab })
	end
	if info.Tooltip then obj.TooltipObj = Library:AddTooltip(info.Tooltip, holder) end
	return obj
end

local function FitLabel(label, right)
	local function upd()
		label.Size = UDim2.new(1, -(right.AbsoluteSize.X / Library.DPIScale + 8), label.Size.Y.Scale, label.Size.Y.Offset)
	end
	right:GetPropertyChangedSignal("AbsoluteSize"):Connect(upd)
	upd()
end

local function MakeRight(holder, top)
	local right = New("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, top and 0 or 0.5),
		Position = UDim2.new(1, 0, top and 0 or 0.5, 0), Size = UDim2.new(0, 0, 0, top and 20 or 26),
		AutomaticSize = Enum.AutomaticSize.X, ZIndex = 2, Parent = holder,
	})
	local l = List(right, 6, Enum.FillDirection.Horizontal)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Right
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	return right
end

local function Register(idx, obj, isToggle)
	if idx == nil then return end
	if isToggle then Library.Toggles[idx] = obj else Library.Options[idx] = obj end
	obj.Idx = idx
end

----------------------------------------------------------------------
-- Toggle / Checkbox
----------------------------------------------------------------------
local AttachKeyPicker, AttachColorPicker

local function MakeToggle(self, idx, info, style)
	info = Validate(info, { Text = "Toggle", Default = false, Callback = function() end, Risky = false, Disabled = false, Visible = true })
	local Toggle = { Type = "Toggle", Text = info.Text, Value = info.Default and true or false, Risky = info.Risky, Style = style, _addons = 0 }
	local Holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = NextOrder(self), Parent = self.Container })
	local Button = New("TextButton", { Size = UDim2.fromScale(1, 1), Parent = Holder })
	local Label = New("TextLabel", { Size = UDim2.new(1, -40, 1, 0), Text = info.Text, TextTruncate = Enum.TextTruncate.AtEnd, Scheme = { TextColor3 = function() return Toggle.Risky and Library.Scheme.RedColor or Library.Scheme.FontColor end }, Parent = Holder })
	local Right = MakeRight(Holder)
	FitLabel(Label, Right)
	Toggle.Right = Right

	local function boxColor()
		return Toggle.Value and Library.Scheme.AccentColor or Library.Scheme.DarkColor
	end
	local Box, Knob, Legs = nil, nil, {}
	if style == "Switch" then
		Box = New("Frame", { Size = UDim2.fromOffset(34, 18), LayoutOrder = 100, Scheme = { BackgroundColor3 = boxColor }, Parent = Right })
		Corner(Box, "full"); Stroke(Box, "OutlineColor", 0.4)
		Knob = New("Frame", { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), Parent = Box })
		Corner(Knob, "full")
	else
		Box = New("Frame", { Size = UDim2.fromOffset(18, 18), LayoutOrder = 100, Scheme = { BackgroundColor3 = boxColor }, Parent = Right })
		Corner(Box, 5); Stroke(Box, "OutlineColor", 0.4)
		Legs[1] = New("Frame", { Size = UDim2.fromOffset(2, 5), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(6, 10.5), Rotation = -45, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Parent = Box })
		Legs[2] = New("Frame", { Size = UDim2.fromOffset(2, 9), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(9.5, 9), Rotation = 45, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Parent = Box })
		Corner(Legs[1], 1); Corner(Legs[2], 1)
	end

	function Toggle:Display()
		Library:Tween(Box, { BackgroundColor3 = boxColor() })
		if Knob then
			Library:Tween(Knob, { Position = self.Value and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
		else
			for _, l in ipairs(Legs) do Library:Tween(l, { BackgroundTransparency = self.Value and 0 or 1 }) end
		end
		Label.TextTransparency = self.Disabled and 0.6 or 0
	end

	function Toggle:SetValue(v)
		v = v and true or false
		if self.Value == v then return end
		self.Value = v
		self:Display()
		if self.KeyPicker and self.KeyPicker.SyncToggleState then
			self.KeyPicker.Toggled = v
			self.KeyPicker:_UpdateList()
		end
		Library:UpdateDependencyBoxes()
		self:_Fire(v)
	end
	function Toggle:SetText(t) self.Text = t; Label.Text = t end
	function Toggle:SetRisky(r) self.Risky = r; Library:UpdateColors() end
	function Toggle:SetDisabled(d) self.Disabled = d and true or false; self:Display() end
	function Toggle:AddKeyPicker(i, inf) AttachKeyPicker(self, i, inf); return self end
	function Toggle:AddColorPicker(i, inf) AttachColorPicker(self, i, inf); return self end

	InitElement(self, Toggle, Holder, info.Text, info)
	if info.Tooltip then Toggle.TooltipObj.Disabled = false end
	Button.MouseButton1Click:Connect(function()
		if Toggle.Disabled then return end
		Toggle:SetValue(not Toggle.Value)
	end)
	Toggle:Display()
	Register(idx, Toggle, true)
	return Toggle
end

function Funcs:AddToggle(idx, info) return MakeToggle(self, idx, info, "Switch") end
function Funcs:AddCheckbox(idx, info) return MakeToggle(self, idx, info, "Checkbox") end

